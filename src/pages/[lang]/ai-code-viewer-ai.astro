---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getContent, localizePost } from '../../i18n/content';
import { nonDefaultLocales, type SupportedLocale } from '../../i18n/config';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getPageSEO, createBreadcrumbSchema } from '../../i18n/seo';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const c = getContent(lang);
const seo = getPageSEO('aiCodeViewer', lang);

const features = c.aicodeFeatures;

// "From the blog": 2 newest AI-related posts. Blog is English-only, so links
// point at the canonical /blog/[slug] with the localized title as label.
const blogPosts: { post: CollectionEntry<'blog'>; loc: { title: string; description: string } }[] = (await getCollection('blog'))
  .filter((p: CollectionEntry<'blog'>) => ['AI Development', 'Generative AI', 'AI Production Systems'].includes(p.data.category))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2)
  .map((post: CollectionEntry<'blog'>) => ({ post, loc: localizePost(post.slug, post.data, lang) }));

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'CodeEnhance AI',
    url: `https://ladestack.in/${lang}/ai-code-viewer-ai`,
    inLanguage: lang,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser',
    description: seo.description,
    creator: { '@type': 'Person', name: 'Girish Lade', email: 'admin@ladestack.in', url: `https://ladestack.in/${lang}/about` },
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: `https://ladestack.in/${lang}` },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: `https://ladestack.in/${lang}` },
    { name: t('nav.apps'), url: `https://ladestack.in/${lang}/apps` },
    { name: seo.breadcrumbName, url: `https://ladestack.in/${lang}/ai-code-viewer-ai` },
  ]),
];
---
<BaseLayout
  lang={lang}
  path="/ai-code-viewer-ai"
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage="https://ladestack.in/AIcode.png"
  structuredData={structuredData}
>
  <section class="marketing-section-dark">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto" data-reveal>
        <MonoEyebrow color="brand" class="mb-3">{t('aicode.badge')}</MonoEyebrow>
        <h1 class="display-md text-on-primary mt-5 mb-4 break-words">CodeEnhance AI</h1>
        <p class="subtitle text-ash max-w-2xl mx-auto mb-8">{t('aicode.subtitle')}</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <Button href="https://code.ladestack.in/" target="_blank" rel="noopener noreferrer" variant="brand">
            {t('aicode.ctaPrimary')} ↗
          </Button>
          <Button href={getLocalizedPath('/apps', lang)} variant="secondary-dark">
            {t('aicode.ctaSecondary')}
          </Button>
        </div>
      </div>

      <!-- Interactive 2-column terminal mockup: window dots + code preview + live render -->
      <div class="mt-12 max-w-5xl mx-auto" data-reveal>
        <FeatureCard variant="dark" class="!p-0 overflow-hidden hover:border-graphite transition-colors lift-on-hover">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-hairline-soft bg-canvas-soft" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-red-400"></span><span class="h-3 w-3 rounded-full bg-amber-400"></span><span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            <span class="ml-2 font-mono text-xs text-ash">{t('aicode.mockupTitle')}</span>
          </div>
          <div class="grid md:grid-cols-2">
            <pre class="p-6 text-xs md:text-sm font-mono overflow-x-auto text-ash"><code>&lt;button class="cta"&gt;{t('aicode.mockupBtn')}&lt;/button&gt;

&lt;style&gt;
.cta &#123;
  background: #f36458;
  color: white;
  padding: 12px 28px;
  border-radius: 999px;
&#125;
&lt;/style&gt;</code></pre>
            <div class="p-6 border-t md:border-t-0 md:border-l border-hairline-soft flex items-center justify-center bg-brand/5">
              <Button variant="brand">{t('aicode.mockupBtn')}</Button>
            </div>
          </div>
        </FeatureCard>
      </div>

      <!-- Features -->
      <div class="mt-12 grid grid-cols-1 xxs:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
        {features.map((f, featureIdx) => (
          <div
            class="flex"
            data-reveal
            data-reveal-delay={String((featureIdx % 4) * 80)}
          >
            <FeatureCard variant="dark" class="w-full hover:border-graphite transition-colors lift-on-hover">
              <h2 class="heading-sm text-on-primary break-words">{f.title}</h2>
              <p class="mt-2 body-sm text-ash leading-relaxed break-words">{f.text}</p>
            </FeatureCard>
          </div>
        ))}
      </div>

      <!-- Stats -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 body-sm text-ash" data-reveal>
        <span>★ 4.8 / 5</span><span aria-hidden="true">·</span><span>{t('aicode.reviews')}</span><span aria-hidden="true">·</span><span>{t('aicode.freeForever')}</span>
      </div>

      <!-- From the blog -->
      {blogPosts.length > 0 && (
        <div class="mt-12 max-w-5xl mx-auto" data-reveal>
          <h2 class="heading-md text-on-primary mb-6 break-words">{t('blog.post.related')}</h2>
          <div class="grid grid-cols-1 xs:grid-cols-2 gap-4">
            {blogPosts.map(({ post, loc }, postIdx) => (
              <div
                class="flex"
                data-reveal
                data-reveal-delay={String((postIdx % 2) * 80)}
              >
                <FeatureCard variant="dark" class="w-full !p-0 overflow-hidden hover:border-graphite transition-colors lift-on-hover">
                  <a href={`/blog/${post.slug}`} class="block group">
                    <Image src={post.data.coverImage} alt={`${loc.title} — related article cover`} width={600} height={192} loading="lazy" decoding="async" class="h-32 w-full object-cover" />
                    <div class="p-5">
                      <p class="mono-micro text-brand">{c.blogCategories[post.data.category] ?? post.data.category}</p>
                      <h3 class="mt-1.5 heading-sm text-on-primary leading-snug group-hover:text-brand transition-colors">{loc.title}</h3>
                    </div>
                  </a>
                </FeatureCard>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
