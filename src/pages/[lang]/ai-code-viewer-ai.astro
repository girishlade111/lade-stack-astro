---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { getContent, localizePost } from '../../i18n/content';
import { nonDefaultLocales, type SupportedLocale } from '../../i18n/config';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getPageSEO, createBreadcrumbSchema } from '../../i18n/seo';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const c = getContent(lang);
const seo = getPageSEO('aiCodeViewer', lang);

const features = c.aicodeFeatures;

// "From the blog": 2 newest AI-related posts. Blog is English-only, so links
// point at the canonical /blog/[slug] with the localized title as label.
const blogPosts: { post: CollectionEntry<'blog'>; loc: { title: string; description: string } }[] = (await getCollection('blog'))
  .filter((p: CollectionEntry<'blog'>) => ['AI Development', 'Generative AI', 'AI Production Systems'].includes(p.data.category))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2)
  .map((post: CollectionEntry<'blog'>) => ({ post, loc: localizePost(post.slug, post.data, lang) }));

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'CodeEnhance AI',
    url: `https://ladestack.in/${lang}/ai-code-viewer-ai`,
    inLanguage: lang,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser',
    description: seo.description,
    creator: { '@type': 'Person', name: 'Girish Lade', email: 'admin@ladestack.in', url: `https://ladestack.in/${lang}/about` },
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: `https://ladestack.in/${lang}` },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: `https://ladestack.in/${lang}` },
    { name: t('nav.apps'), url: `https://ladestack.in/${lang}/apps` },
    { name: seo.breadcrumbName, url: `https://ladestack.in/${lang}/ai-code-viewer-ai` },
  ]),
];
---
<BaseLayout
  lang={lang}
  path="/ai-code-viewer-ai"
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage="https://ladestack.in/AIcode.png"
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 text-center">
    <p class="inline-block text-xs font-mono px-4 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/20">{t('aicode.badge')}</p>
    <h1 class="font-serif text-4xl md:text-6xl font-bold mt-5 max-w-3xl mx-auto leading-tight break-words">CodeEnhance AI</h1>
    <p class="mt-4 text-foreground/65 max-w-2xl mx-auto md:text-lg">{t('aicode.subtitle')}</p>
    <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
      <a href="https://code.ladestack.in/" target="_blank" rel="noopener noreferrer" class="inline-flex h-12 px-8 items-center justify-center rounded-full bg-brand text-white font-semibold hover:opacity-90">{t('aicode.ctaPrimary')} ↗</a>
      <a href={getLocalizedPath('/apps', lang)} class="inline-flex h-12 px-8 items-center justify-center rounded-full border border-border font-semibold hover:bg-muted">{t('aicode.ctaSecondary')}</a>
    </div>

    <div class="mt-12 rounded-3xl border border-border bg-card/60 overflow-hidden text-left">
      <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border bg-muted/50" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-red-400"></span><span class="h-3 w-3 rounded-full bg-amber-400"></span><span class="h-3 w-3 rounded-full bg-emerald-400"></span>
        <span class="ml-2 font-mono text-xs text-foreground/55">{t('aicode.mockupTitle')}</span>
      </div>
      <div class="grid md:grid-cols-2">
        <pre class="p-6 text-xs md:text-sm font-mono overflow-x-auto text-foreground/80"><code>&lt;button class="cta"&gt;{t('aicode.mockupBtn')}&lt;/button&gt;

&lt;style&gt;
.cta &#123;
  background: #6E8F6A;
  color: white;
  padding: 12px 28px;
  border-radius: 999px;
&#125;
&lt;/style&gt;</code></pre>
        <div class="p-6 border-t md:border-t-0 md:border-l border-border flex items-center justify-center bg-primary/5">
          <span class="inline-flex h-12 px-8 items-center justify-center rounded-full text-white font-semibold" style="background:#6E8F6A">{t('aicode.mockupBtn')}</span>
        </div>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 xxs:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
      {features.map((f) => (
        <div class="rounded-2xl border border-border bg-card/60 p-6">
          <h2 class="font-semibold break-words">{f.title}</h2>
          <p class="mt-2 text-sm text-foreground/65">{f.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-foreground/60">
      <span>★ 4.8 / 5</span><span>·</span><span>{t('aicode.reviews')}</span><span>·</span><span>{t('aicode.freeForever')}</span>
    </div>

    {blogPosts.length > 0 && (
      <div class="mt-12 rounded-3xl border border-border bg-card/60 p-6 sm:p-8 text-left">
        <h2 class="font-serif text-2xl font-bold break-words">{t('blog.post.related')}</h2>
        <div class="mt-5 grid grid-cols-1 xs:grid-cols-2 gap-4">
          {blogPosts.map(({ post, loc }) => (
            <a href={`/blog/${post.slug}`} class="rounded-2xl border border-border bg-card/60 overflow-hidden hover:border-primary/40 hover:shadow-lg transition-all">
              <Image src={post.data.coverImage} alt={`${loc.title} — related article cover`} width={600} height={192} loading="lazy" decoding="async" class="h-32 w-full object-cover" />
              <div class="p-5">
                <p class="text-[11px] font-mono text-primary">{c.blogCategories[post.data.category] ?? post.data.category}</p>
                <h3 class="mt-1.5 font-semibold leading-snug">{loc.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
