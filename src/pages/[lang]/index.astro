---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import ValuesSection from '@/components/sections/ValuesSection.astro';
import ImpactSection from '@/components/sections/ImpactSection.astro';
import ProductsSection from '@/components/sections/ProductsSection.astro';
import FreeForeverSection from '@/components/sections/FreeForeverSection.astro';
import CommunitySection from '@/components/sections/CommunitySection.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import { languages, type SupportedLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import { getContent } from '@/i18n/content';

export function getStaticPaths() {
  // Exclude default 'en' because it lives at root index.astro
  return Object.keys(languages)
    .filter((l) => l !== 'en')
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const c = getContent(lang);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `https://ladestack.in/${lang}/#webapp`,
    applicationCategory: 'DeveloperApplication',
    name: 'Lade Stack',
    url: `https://ladestack.in/${lang}`,
    description: c.metaDescription,
    operatingSystem: 'Web Browser',
    inLanguage: lang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': 'https://ladestack.in/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `https://ladestack.in/${lang}/#website`,
    name: 'Lade Stack',
    url: `https://ladestack.in/${lang}`,
    description: c.metaDescription,
    inLanguage: lang,
    publisher: { '@id': 'https://ladestack.in/#organization' },
  }
];
---

<BaseLayout
  title={`${t('hero.title.part1')} ${t('hero.title.part2')} | Lade Stack`}
  description={c.metaDescription}
  lang={lang}
  path="/"
  structuredData={structuredData}
>
  <HeroSection lang={lang} />
  <AboutSection lang={lang} />
  <ValuesSection lang={lang} />
  <ImpactSection lang={lang} />
  <ProductsSection lang={lang} />
  <FreeForeverSection lang={lang} />
  <CommunitySection lang={lang} />
  <Testimonials lang={lang} />
</BaseLayout>
