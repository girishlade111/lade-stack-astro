---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/utils';
import { getContent } from '@/i18n/content';
import { nonDefaultLocales, type SupportedLocale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const c = getContent(lang);

const faqs = c.contactFaqs;

const contactStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Lade Stack',
  url: `https://ladestack.in/${lang}/contact`,
  inLanguage: lang,
  description: t('contact.subtitle')
};
---

<BaseLayout
  title={`${t('contact.title')} | Lade Stack`}
  description={t('contact.subtitle')}
  lang={lang}
  path="/contact"
  structuredData={contactStructuredData}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="text-center mb-16">
      <span class="text-xs font-semibold text-primary uppercase tracking-widest">Get In Touch</span>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-foreground mt-2">
        {t('contact.title')}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-muted-foreground">
        {t('contact.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-20">
      <div class="space-y-6">
        <div class="p-6 rounded-3xl border border-border bg-card">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-4">
            <Icon name="lucide:mail" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">{t('contact.infoEmail')}</h3>
          <p class="text-xs text-muted-foreground mt-1">{t('contact.infoEmailSub')}</p>
          <a href="mailto:admin@ladestack.in" class="mt-3 inline-block text-sm font-semibold text-primary hover:underline">
            admin@ladestack.in
          </a>
        </div>

        <div class="p-6 rounded-3xl border border-border bg-card">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-4">
            <Icon name="lucide:map-pin" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">{t('contact.infoLocation')}</h3>
          <p class="text-xs text-muted-foreground mt-1">{t('contact.infoLocationSub')}</p>
          <p class="mt-3 text-sm font-semibold text-foreground">Mumbai, India</p>
        </div>
      </div>

      <div class="p-8 rounded-3xl border border-border bg-card shadow-sm">
        <h2 class="text-xl font-bold text-foreground mb-6">{t('contact.sendTitle')}</h2>
        <form id="contact-form" class="space-y-4" data-endpoint="https://formspree.io/f/xayvkzgw" novalidate>
          <div>
            <label class="block text-xs font-semibold text-foreground mb-1.5" for="c-name">{t('contact.formName')}</label>
            <input type="text" id="c-name" name="name" required minlength="2" autocomplete="name" class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm focus:ring-2 focus:ring-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-foreground mb-1.5" for="c-email">{t('contact.formEmail')}</label>
            <input type="email" id="c-email" name="email" required autocomplete="email" class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm focus:ring-2 focus:ring-primary focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-foreground mb-1.5" for="c-msg">{t('contact.formMessage')}</label>
            <textarea id="c-msg" name="message" rows="4" required minlength="10" class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm focus:ring-2 focus:ring-primary focus:outline-none"></textarea>
          </div>
          <p id="c-form-error" class="hidden text-sm font-medium text-error" role="alert"></p>
          <button
            type="submit"
            id="c-submit-btn"
            data-sending={t('common.loading')}
            class="w-full py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary/90 transition-all shadow-sm"
          >
            {t('contact.formSubmit')}
          </button>
        </form>
        <div id="c-success-msg" class="hidden mt-4 p-4 rounded-xl bg-primary/10 border border-primary/30 text-xs font-semibold text-primary text-center" role="status" aria-live="polite" tabindex="-1">
          {t('contact.formSuccess')}
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-foreground text-center mb-8">
        {t('contact.faqTitle')}
      </h2>
      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="group p-6 rounded-2xl border border-border bg-card transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer font-semibold text-foreground text-sm list-none">
                <span>{faq.q}</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-muted-foreground group-open:rotate-180 transition-transform" />
              </summary>
              <p class="mt-4 text-sm text-muted-foreground leading-relaxed pt-4 border-t border-border/50">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  /** Real submission (Formspree) + validation + a11y focus (A10). */
  function setupContactForm() {
    var form = /** @type {HTMLFormElement | null} */ (document.getElementById('contact-form'));
    var success = document.getElementById('c-success-msg');
    var btn = /** @type {HTMLButtonElement | null} */ (document.getElementById('c-submit-btn'));
    var errBox = document.getElementById('c-form-error');
    if (!form || !success || !btn) return;
    if (form.hasAttribute('data-wired')) return;
    form.setAttribute('data-wired', 'true');
    var idleLabel = btn.innerText;
    function showError(msg) { if (!errBox) return; errBox.textContent = msg; errBox.classList.remove('hidden'); try { errBox.focus(); } catch (e) {} }
    function clearError() { if (errBox) { errBox.textContent = ''; errBox.classList.add('hidden'); } }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearError();
      var name = /** @type {HTMLInputElement | null} */ (document.getElementById('c-name'));
      var email = /** @type {HTMLInputElement | null} */ (document.getElementById('c-email'));
      var msg = /** @type {HTMLTextAreaElement | null} */ (document.getElementById('c-msg'));
      var nameV = name && name.value ? name.value.trim() : '';
      var emailV = email && email.value ? email.value.trim() : '';
      var msgV = msg && msg.value ? msg.value.trim() : '';
      if (nameV.length < 2) { showError('Please enter your name (at least 2 characters).'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailV)) { showError('Please enter a valid email address.'); return; }
      if (msgV.length < 10) { showError('Please write a message of at least 10 characters.'); return; }
      btn.innerText = btn.getAttribute('data-sending') || 'Sending...';
      btn.disabled = true;
      var endpoint = form.getAttribute('data-endpoint') || '';
      function onOk() { form.reset(); form.style.display = 'none'; success.classList.remove('hidden'); try { success.focus(); } catch (err) {} }
      function onFail() { btn.disabled = false; btn.innerText = idleLabel; showError('Something went wrong. Please try again or email admin@ladestack.in.'); }
      if (!endpoint) { window.setTimeout(onOk, 600); return; }
      fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ name: nameV, email: emailV, message: msgV }) })
        .then(function (r) { if (!r.ok) throw new Error('bad status'); onOk(); })
        .catch(onFail);
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
