---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile.png';
import { getContent } from '@/i18n/content';
import { nonDefaultLocales, type SupportedLocale } from '@/i18n/config';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Icon from '@/components/Icon.astro';
import { getPageSEO, createBreadcrumbSchema } from '@/i18n/seo';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const c = getContent(lang);
const about = c.aboutPage;
const timeline = c.timeline;
const stack = ['TypeScript', 'Astro', 'Python', 'AI Systems', 'Tailwind CSS', 'PostgreSQL'];
const seo = getPageSEO('about', lang);

const aboutStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Girish Lade',
    jobTitle: about.founderRole,
    url: `https://ladestack.in/${lang}/about`,
    inLanguage: lang,
    sameAs: [
      'https://github.com/girishlade111',
      'https://www.linkedin.com/in/girish-lade-075bba201/',
      'https://www.instagram.com/girish_lade_/',
      'https://codepen.io/Girish-Lade-the-looper'
    ],
    worksFor: {
      '@type': 'Organization',
      name: 'Lade Stack',
      url: `https://ladestack.in/${lang}`,
    },
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: `https://ladestack.in/${lang}` },
    { name: seo.breadcrumbName, url: `https://ladestack.in/${lang}/about` },
  ]),
];
---

<BaseLayout
  title={`${about.metaTitle} | Lade Stack`}
  description={about.metaDescription}
  keywords={about.metaKeywords}
  lang={lang}
  path="/about"
  structuredData={aboutStructuredData}
>
  <div class="marketing-section-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Hero / Personal Introduction -->
      <div class="text-center mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.heroEyebrow}</MonoEyebrow>
        <h1 class="display-md text-on-primary mb-4 break-words">
          {about.heroTitle}
        </h1>
        <p class="subtitle text-ash max-w-2xl mx-auto leading-relaxed">
          {about.heroSubtitle}
        </p>
      </div>

      <!-- Founder Spotlight Card -->
      <FeatureCard variant="dark" class="mb-16">
        <div class="flex flex-col sm:flex-row items-center gap-8">
          <div class="w-44 sm:w-52 aspect-[2/3] shrink-0 rounded-2xl border border-hairline-soft bg-canvas p-1.5 shadow-lg overflow-hidden flex items-center justify-center">
            <Image
              src={profileImg}
              alt={about.imageAlt}
              widths={[208, 416]}
              sizes="(max-width: 640px) 176px, 208px"
              format="avif"
              class="w-full h-full object-contain rounded-xl"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="heading-md text-on-primary">Girish Lade</h2>
              <span class="mono-micro text-mute">{about.founderLocation}</span>
            </div>
            <p class="mono-eyebrow text-brand mt-1">{about.founderRole}</p>
            <p class="body text-ash mt-4 leading-relaxed">
              {about.founderBio1}
            </p>
            <p class="body text-ash mt-3 leading-relaxed">
              {about.founderBio2}
            </p>
            <div class="flex items-center gap-3 mt-6">
              <a
                href="https://github.com/girishlade111"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-app-sm border border-hairline-soft hover:bg-canvas text-ash hover:text-on-primary transition-colors"
                aria-label="GitHub"
              >
                <Icon name="lucide:github" class="w-4 h-4" />
              </a>
              <a
                href="https://www.linkedin.com/in/girish-lade-075bba201/"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-app-sm border border-hairline-soft hover:bg-canvas text-ash hover:text-on-primary transition-colors"
                aria-label="LinkedIn"
              >
                <Icon name="lucide:linkedin" class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </FeatureCard>

      <!-- Personal Story: Who I Am & The Builder's Evolution -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.storyEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-6">{about.storyTitle}</h2>
        <div class="space-y-4 body text-ash leading-relaxed">
          {about.storyParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <!-- What I Build: Products & Problem Solving -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.whatBuildEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-4">{about.whatBuildTitle}</h2>
        <p class="body text-ash leading-relaxed mb-8">
          {about.whatBuildSubtitle}
        </p>
        <div class="grid xs:grid-cols-2 gap-6">
          {about.whatBuildItems.map((item) => (
            <FeatureCard variant="dark">
              <div class="mono-micro text-brand mb-3">{item.num}</div>
              <h3 class="heading-sm text-on-primary mb-2">{item.title}</h3>
              <p class="body-sm text-ash leading-relaxed">{item.desc}</p>
            </FeatureCard>
          ))}
        </div>
      </div>

      <!-- UI/UX + Engineering Connection -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.craftEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-6">{about.craftTitle}</h2>
        <div class="space-y-4 body text-ash leading-relaxed">
          {about.craftParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <!-- Generative AI & Practical Systems -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.aiEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-6">{about.aiTitle}</h2>
        <div class="space-y-4 body text-ash leading-relaxed">
          {about.aiParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <div class="grid xs:grid-cols-2 gap-4 mt-6">
          {about.aiPillars.map((pillar) => (
            <div class="p-4 rounded-xl border border-hairline-soft bg-canvas/40">
              <h3 class="heading-sm text-on-primary text-base font-medium mb-1">{pillar.title}</h3>
              <p class="body-sm text-ash leading-relaxed">{pillar.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Engineering Philosophy -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.philosophyEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-6">{about.philosophyTitle}</h2>
        <div class="space-y-6">
          {about.philosophyItems.map((item) => (
            <div class="border-l-2 border-brand pl-4">
              <h3 class="heading-sm text-on-primary text-lg font-medium">{item.title}</h3>
              <p class="body-sm text-ash mt-1 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- How I Work -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.workEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-4">{about.workTitle}</h2>
        <p class="body text-ash leading-relaxed mb-6">
          {about.workSubtitle}
        </p>
        <ol class="space-y-4 body-sm text-ash">
          {about.workSteps.map((s) => (
            <li class="flex items-start gap-4 p-4 rounded-xl border border-hairline-soft bg-canvas/30">
              <span class="mono-eyebrow text-brand font-bold shrink-0 mt-0.5">{s.step}</span>
              <div>
                <span class="text-on-primary font-medium block mb-1">{s.title}</span>
                <span>{s.desc}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Technical Breadth & Ecosystem -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.ecosystemEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-4">{about.ecosystemTitle}</h2>
        <p class="body text-ash leading-relaxed mb-6">
          {about.ecosystemSubtitle}
        </p>
        <div class="space-y-4">
          {about.ecosystemGroups.map((group) => (
            <div class="p-4 rounded-xl border border-hairline-soft bg-canvas/40">
              <div class="mono-micro text-mute uppercase tracking-wider mb-2">{group.label}</div>
              <p class="body-sm text-ash mb-3 leading-relaxed">
                {group.desc}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.tags.map((tag) => (
                  <span class="btn-app-tab !h-7 !px-2.5 !text-xs">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Continuous Learning & Growth -->
      <div class="mb-16">
        <MonoEyebrow color="brand" class="mb-3">{about.learningEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-4">{about.learningTitle}</h2>
        <p class="body text-ash leading-relaxed mb-6">
          {about.learningSubtitle}
        </p>
        <div class="grid xs:grid-cols-2 lg:grid-cols-3 gap-6">
          {about.learningCards.map((card) => (
            <FeatureCard variant="dark">
              <div class="mono-micro text-brand mb-2">{card.badge}</div>
              <h3 class="heading-sm text-on-primary text-base font-medium mb-2">{card.title}</h3>
              <p class="body-sm text-ash leading-relaxed">{card.desc}</p>
            </FeatureCard>
          ))}
        </div>
      </div>

      <!-- Core Stack Section -->
      <div class="text-center mb-16">
        <MonoEyebrow color="mute" class="mb-2">{about.stackEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-3">{about.stackTitle}</h2>
        <p class="body-sm text-ash max-w-xl mx-auto mb-6 leading-relaxed">
          {about.stackSubtitle}
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          {stack.map((s) => (
            <span class="btn-app-tab !h-8 !px-3">{s}</span>
          ))}
        </div>
      </div>

      <!-- Journey Timeline -->
      <div class="mb-16">
        <div class="text-center mb-10">
          <MonoEyebrow color="mute" class="mb-2">{about.journeyEyebrow}</MonoEyebrow>
          <h2 class="heading-md text-on-primary">{about.journeyTitle}</h2>
        </div>
        <ol class="relative border-l border-hairline-soft ml-4 space-y-8 max-w-2xl mx-auto">
          {timeline.map((item) => (
            <li class="ml-6">
              <span class="absolute -left-[5px] mt-1 h-2.5 w-2.5 rounded-full bg-brand" aria-hidden="true"></span>
              <p class="mono-eyebrow text-brand">{item.year}</p>
              <h3 class="heading-sm text-on-primary mt-0.5">{item.title}</h3>
              <p class="body-sm text-ash mt-1 leading-relaxed">{item.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Future Direction & Personal Statement -->
      <FeatureCard variant="dark" class="text-center py-10">
        <MonoEyebrow color="brand" class="mb-3">{about.futureEyebrow}</MonoEyebrow>
        <h2 class="heading-md text-on-primary mb-4">{about.futureTitle}</h2>
        <p class="body text-ash max-w-2xl mx-auto leading-relaxed mb-4">
          {about.futureBody}
        </p>
        <p class="body-sm text-ash/80 max-w-xl mx-auto leading-relaxed">
          {about.futureQuote}
        </p>
        <div class="mt-6">
          <span class="caption font-medium text-on-primary">{about.futureAuthor}</span>
        </div>
      </FeatureCard>
    </div>
  </div>
</BaseLayout>
