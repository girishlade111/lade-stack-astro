---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { nonDefaultLocales, type SupportedLocale } from '../../i18n/config';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const updated = '2026-09-09';
const sections = [
  { h: 'Information we collect', p: 'Minimal data: contact messages, opt-in newsletter emails, and privacy-respecting analytics. Core tools process files in your browser — documents never reach our servers.' },
  { h: 'How we use information', p: 'To respond to requests, send requested newsletters, and improve reliability. We never sell personal data.' },
  { h: 'Cookies & storage', p: 'Theme and language preferences live in localStorage on your device.' },
  { h: 'Your rights', p: 'Request access, correction, or deletion anytime at admin@ladestack.in.' }
];
---
<BaseLayout lang={lang} path="/privacy" title="Privacy Policy - Lade Stack" description="How Lade Stack collects, uses, and protects your personal information.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-5xl font-bold">Privacy Policy</h1>
    <p class="mt-3 text-sm text-foreground/55">Last updated: {updated}</p>
    <div class="mt-8 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="font-serif text-xl md:text-2xl font-bold">{s.h}</h2>
          <p class="mt-2 text-foreground/70 leading-relaxed">{s.p}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
