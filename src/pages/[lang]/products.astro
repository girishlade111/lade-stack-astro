---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductsSection from '@/components/sections/ProductsSection.astro';
import { useTranslations } from '@/i18n/utils';
import { nonDefaultLocales, type SupportedLocale } from '@/i18n/config';
import { getPageSEO, createBreadcrumbSchema } from '@/i18n/seo';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const seo = getPageSEO('products', lang);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seo.title,
    url: `https://ladestack.in/${lang}/products`,
    inLanguage: lang,
    description: seo.description,
    mainEntity: [
      {
        '@type': 'SoftwareApplication',
        name: 'CodeEnhance AI',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: `https://ladestack.in/${lang}/ai-code-viewer-ai`,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'API Testing Platform',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: `https://ladestack.in/${lang}/products`,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'Website Builder AI',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: `https://ladestack.in/${lang}/products`,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'Secure File Hub',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: `https://ladestack.in/${lang}/products`,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      }
    ]
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: `https://ladestack.in/${lang}` },
    { name: seo.breadcrumbName, url: `https://ladestack.in/${lang}/products` },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  lang={lang}
  path="/products"
  structuredData={structuredData}
>
  <ProductsSection lang={lang} isPage={true} />
</BaseLayout>

