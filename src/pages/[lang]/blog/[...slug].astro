---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import { localizePost, getContent, getLocalizedApps, getPostSlug, getBlogPostsForLocale } from '@/i18n/content';
import { nonDefaultLocales, languages, type SupportedLocale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
  return nonDefaultLocales.flatMap((lang) => {
    const posts = getBlogPostsForLocale(lang, allPosts);
    return posts.map(({ post, isFallback, cleanSlug }) => ({
      params: { lang, slug: cleanSlug },
      props: { post, isFallback, cleanSlug },
    }));
  });
}

const { lang } = Astro.params as { lang: SupportedLocale };
const { post, isFallback, cleanSlug } = Astro.props as {
  post: CollectionEntry<'blog'>;
  isFallback: boolean;
  cleanSlug: string;
};

const t = useTranslations(lang);
const c = getContent(lang);
const currentLangMeta = languages[lang] ?? languages.en;
const loc = localizePost(cleanSlug, post.data, lang);
const { Content, headings } = await render(post);
type TocHeading = { depth: number; slug: string; text: string };
const toc: TocHeading[] = (headings as TocHeading[]).filter((h) => h.depth <= 3);

// lastmod prefers updatedDate (only set when edited post-publish) over pubDate.
const modifiedDate = post.data.updatedDate ?? post.data.pubDate;
const isoDate = post.data.pubDate.toISOString();
const isoModified = modifiedDate.toISOString();

// Related posts: score by shared category (+2) and overlapping tags (+1 each),
// newest first, excluding the current post, max 3.
const all: CollectionEntry<'blog'>[] = getBlogPostsForLocale(lang, await getCollection('blog')).map((e) => e.post);
const scored = all
  .filter((p) => getPostSlug(p) !== cleanSlug)
  .map((p) => {
    let score = 0;
    if (p.data.category === post.data.category) score += 2;
    score += p.data.tags.filter((tag: string) => post.data.tags.includes(tag)).length;
    return { p, score };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ p }) => p);
const relatedPool = scored.length ? scored : all.filter((p) => getPostSlug(p) !== cleanSlug).slice(0, 3);
const relatedLoc = relatedPool.map((r) => {
  const rSlug = getPostSlug(r);
  return { r, cleanSlug: rSlug, loc: localizePost(rSlug, r.data, lang) };
});

// Related tools: app IDs from frontmatter resolved via apps.json.
const relatedTools = getLocalizedApps(lang).filter((app) => (post.data.relatedApps ?? []).includes(app.id));

// Breadcrumb trail is emitted via SEO.astro `breadcrumbs` (single BreadcrumbList).
const breadcrumbs = [
  { name: 'Home', url: `https://ladestack.in${getLocalizedPath('/', lang)}` },
  { name: 'Blog', url: `https://ladestack.in${getLocalizedPath('/blog', lang)}` },
  { name: loc.title, url: `https://ladestack.in${getLocalizedPath(`/blog/${cleanSlug}`, lang)}` },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: loc.title,
    description: loc.description,
    image: `https://ladestack.in${post.data.coverImage}`,
    datePublished: isoDate,
    dateModified: isoModified,
    inLanguage: currentLangMeta.iso,
    author: { '@type': 'Person', name: post.data.author, url: 'https://ladestack.in/about' },
    publisher: { '@type': 'Organization', name: 'Lade Stack', logo: { '@type': 'ImageObject', url: 'https://ladestack.in/icon-512.png', width: 512, height: 512 } },
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://ladestack.in/${lang}/blog/${cleanSlug}` }
  },
];
---
<BaseLayout
  lang={lang}
  path={`/${lang}/blog/${cleanSlug}`}
  title={`${loc.title} | Lade Stack Blog`}
  description={loc.description}
  keywords={post.data.tags.join(', ')}
  ogType="article"
  ogImage={`https://ladestack.in${post.data.coverImage}`}
  article={{ publishedTime: isoDate, modifiedTime: isoModified, author: post.data.author, tags: post.data.tags }}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  hreflang={!isFallback}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-foreground/55">
      <a href={getLocalizedPath('/', lang)} class="hover:text-foreground">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={getLocalizedPath('/blog', lang)} class="hover:text-foreground">Blog</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-foreground/80">{c.blogCategories[post.data.category] ?? post.data.category}</span>
    </nav>

    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-4">
        {c.blogCategories[post.data.category] ?? post.data.category}
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-foreground leading-tight break-words">
        {loc.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs sm:text-sm text-muted-foreground">
        <span>{t('common.byAuthor')} {post.data.author}</span>
        <span aria-hidden="true" class="hidden xxs:inline">•</span>
        <span>{post.data.pubDate.toLocaleDateString(currentLangMeta.iso, { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true" class="hidden xxs:inline">•</span>
            <span>Updated {post.data.updatedDate.toLocaleDateString(currentLangMeta.iso, { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          </>
        )}
        <span aria-hidden="true" class="hidden xxs:inline">•</span>
        <span>{post.data.readTime} {t('common.minRead')}</span>
      </div>
      <p class="mt-4 text-muted-foreground md:text-lg">{loc.description}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs px-2.5 py-1 rounded-full border border-border text-muted-foreground">#{tag}</span>
        ))}
      </div>
    </div>

    <!-- Fallback Banner if untranslated copy -->
    {isFallback && (
      <div class="max-w-3xl mx-auto mb-8 p-4 sm:p-5 rounded-2xl border border-hairline-soft bg-canvas-soft/80 flex items-center gap-3.5 text-sm text-ash">
        <Icon name="lucide:globe" class="w-5 h-5 text-brand shrink-0" />
        <span>
          Available in English — {currentLangMeta.name} translation coming soon.
        </span>
      </div>
    )}

    <Image src={post.data.coverImage} alt={`${loc.title} — cover illustration`} width={1200} height={630} loading="eager" fetchpriority="high" decoding="async" class="mt-8 rounded-3xl border border-border w-full max-h-[420px] object-cover" />

    <div class="mt-10 grid lg:grid-cols-[220px_1fr] gap-10">
      <aside class="hidden lg:block">
        <div class="sticky top-24 rounded-2xl border border-border bg-card/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-foreground/55">{t('blog.post.toc')}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {toc.map((h) => (
              <li style={`margin-left: ${(h.depth - 2) * 12}px`}>
                <a href={`#${h.slug}`} class="text-foreground/70 hover:text-primary transition-colors">{h.text}</a>
              </li>
            ))}
          </ul>
          <button type="button" data-copy-link class="mt-4 w-full h-9 rounded-full border border-border text-sm font-medium hover:bg-muted transition-colors">
            {t('blog.post.share')} · {t('common.copyLink')}
          </button>
        </div>
      </aside>

      <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-serif prose-a:text-primary prose-code:text-primary prose-pre:rounded-2xl min-w-0" data-article-body data-copy-label={t('blog.post.copyCode')} data-copied-label={t('blog.post.copiedCode')}>
        <Content />
      </div>
    </div>

    {relatedTools.length > 0 && (
      <section class="mt-16" aria-label="Related tools">
        <h2 class="font-serif text-2xl md:text-3xl font-bold break-words">Related Tool{relatedTools.length > 1 ? 's' : ''}</h2>
        <div class="mt-6 grid grid-cols-1 xs:grid-cols-2 gap-4">
          {relatedTools.map((app) => (
            app.comingSoon || !app.landingUrl ? (
              <div class="rounded-2xl border border-border bg-card/60 p-6" aria-disabled="true">
                <p class="text-[11px] font-mono text-muted-foreground">{app.displayCategory}</p>
                <h3 class="mt-1.5 font-semibold text-lg leading-snug break-words">{app.title}</h3>
                <p class="mt-2 text-sm text-foreground/65">{app.tagline}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-muted-foreground">Coming Soon — {app.title}</span>
              </div>
            ) : (
            <a href={app.landingUrl.startsWith('http') ? app.landingUrl : getLocalizedPath(app.landingUrl, lang)} class="rounded-2xl border border-border bg-card/60 p-6 hover:border-primary/40 hover:shadow-lg transition-all">
              <p class="text-[11px] font-mono text-primary">{app.displayCategory}</p>
              <h3 class="mt-1.5 font-semibold text-lg leading-snug break-words">{app.title}</h3>
              <p class="mt-2 text-sm text-foreground/65">{app.tagline}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary">Try it free →</span>
            </a>
            )
          ))}
        </div>
      </section>
    )}

    <section class="mt-16" aria-label={t('blog.post.related')}>
      <h2 class="font-serif text-2xl md:text-3xl font-bold break-words">{t('blog.post.related')}</h2>
      <div class="mt-6 grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedLoc.map(({ r, cleanSlug: rSlug, loc }) => (
          <a href={`/${lang}/blog/${rSlug}`} class="rounded-2xl border border-border bg-card/60 overflow-hidden hover:border-primary/40 hover:shadow-lg transition-all">
            <Image src={r.data.coverImage} alt={`${loc.title} — related article cover`} width={600} height={216} loading="lazy" decoding="async" class="h-36 w-full object-cover" />
            <div class="p-5">
              <p class="text-[11px] font-mono text-primary">{r.data.category}</p>
              <h3 class="mt-1.5 font-semibold leading-snug">{loc.title}</h3>
              <p class="mt-2 text-xs text-foreground/55">{r.data.pubDate.toISOString().slice(0, 10)} · {r.data.readTime} {t('common.minRead')}</p>
            </div>
          </a>
        ))}
      </div>
      <a href={`/${lang}/blog`} class="mt-8 inline-flex items-center gap-2 font-semibold text-brand hover:underline">← {t('blog.post.backToBlog')}</a>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  function setupArticleEnhancements() {
    var wrap = document.querySelector('[data-article-body]');
    if (!wrap) return;
    var copyLabel = (wrap && wrap.getAttribute('data-copy-label')) || 'Copy';
    var copiedLabel = (wrap && wrap.getAttribute('data-copied-label')) || 'Copied!';
    document.querySelectorAll('[data-article-body] pre').forEach(function (pre) {
      if (pre.querySelector('[data-copy-code]')) return;
      pre.style.position = 'relative';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-copy-code', '');
      btn.textContent = copyLabel;
      btn.style.cssText = 'position:absolute;top:8px;right:8px;font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid rgba(128,128,128,.35);background:rgba(0,0,0,.45);color:#fff;cursor:pointer;';
      btn.addEventListener('click', function () {
        var code = pre.querySelector('code');
        var text = code ? code.innerText : pre.innerText;
        function done() { btn.textContent = copiedLabel; setTimeout(function () { btn.textContent = copyLabel; }, 2000); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
      pre.appendChild(btn);
    });
    document.querySelectorAll('[data-copy-link]').forEach(function (btn) {
      if (btn.hasAttribute('data-wired')) return;
      btn.setAttribute('data-wired', 'true');
      var idleLabel = btn.textContent;
      btn.addEventListener('click', function () {
        var url = window.location.href;
        function done() {
          btn.textContent = copiedLabel;
          setTimeout(function () { btn.textContent = idleLabel; }, 2000);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(done);
        } else { done(); }
      });
    });
  }

  setupArticleEnhancements();
  document.addEventListener('astro:page-load', setupArticleEnhancements);
</script>
