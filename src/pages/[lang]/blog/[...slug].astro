---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { localizePost, getContent } from '../../../i18n/content';
import { nonDefaultLocales, languages, type SupportedLocale } from '../../../i18n/config';

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getCollection('blog');
  return nonDefaultLocales.flatMap((lang) => posts.map((post) => ({ params: { lang, slug: post.slug }, props: { post } })));
}

const { lang } = Astro.params as { lang: SupportedLocale; slug: string };
const t = useTranslations(lang);
const c = getContent(lang);
const dateLocale = languages[lang].iso.replace('_', '-');
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const loc = localizePost(post.slug, post.data, lang);
const { Content, headings } = await render(post);
type TocHeading = { depth: number; slug: string; text: string };
const toc: TocHeading[] = (headings as TocHeading[]).filter((h) => h.depth <= 3);

const all: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = all.filter((p) => p.slug !== post.slug && p.data.category === post.data.category).slice(0, 3);
const fallbackRelated = related.length ? related : all.filter((p) => p.slug !== post.slug).slice(0, 3);
const relatedLoc = fallbackRelated.map((r) => ({ r, loc: localizePost(r.slug, r.data, lang) }));

const isoDate = post.data.pubDate.toISOString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: loc.title,
  description: loc.description,
  image: `https://ladestack.in${post.data.coverImage}`,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: lang,
  author: { '@type': 'Person', name: post.data.author, url: 'https://ladestack.in/about' },
  publisher: { '@type': 'Organization', name: 'Lade Stack', logo: { '@type': 'ImageObject', url: 'https://ladestack.in/favicon.ico' } },
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://ladestack.in/${lang}/blog/${post.slug}` }
};
---
<BaseLayout
  lang={lang}
  path={`/blog/${post.slug}`}
  title={`${loc.title} | Lade Stack Blog`}
  description={loc.description}
  keywords={post.data.tags.join(', ')}
  ogType="article"
  ogImage={`https://ladestack.in${post.data.coverImage}`}
  article={{ publishedTime: isoDate, modifiedTime: isoDate, author: post.data.author, tags: post.data.tags }}
  structuredData={structuredData}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-foreground/55">
      <a href={getLocalizedPath('/', lang)} class="hover:text-foreground">{t('nav.home')}</a>
      <span aria-hidden="true"> / </span>
      <a href={getLocalizedPath('/blog', lang)} class="hover:text-foreground">{t('nav.blog')}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-foreground/80">{c.blogCategories[post.data.category] ?? post.data.category}</span>
    </nav>

    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-4">
        {c.blogCategories[post.data.category] ?? post.data.category}
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-foreground leading-tight">
        {loc.title}
      </h1>
      <div class="mt-4 flex items-center justify-center gap-4 text-xs sm:text-sm text-muted-foreground">
        <span>{t('common.byAuthor')} {post.data.author}</span>
        <span aria-hidden="true">•</span>
        <span>{post.data.pubDate.toLocaleDateString(dateLocale, { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        <span aria-hidden="true">•</span>
        <span>{parseInt(post.data.readTime)} {t('common.minRead')}</span>
      </div>
      <p class="mt-4 text-muted-foreground md:text-lg">{loc.description}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {post.data.tags.map((tag: string) => (
          <span class="text-xs px-2.5 py-1 rounded-full border border-border text-muted-foreground">#{tag}</span>
        ))}
      </div>
    </div>

    <img src={post.data.coverImage} alt={loc.title} class="mt-8 rounded-3xl border border-border w-full max-h-[420px] object-cover" loading="eager" />

    <div class="mt-10 grid lg:grid-cols-[220px_1fr] gap-10">
      <aside class="hidden lg:block">
        <div class="sticky top-24 rounded-2xl border border-border bg-card/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-wider text-foreground/55">{t('blog.post.toc')}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {toc.map((h) => (
              <li style={`margin-left: ${(h.depth - 2) * 12}px`}>
                <a href={`#${h.slug}`} class="text-foreground/70 hover:text-sage-500 transition-colors">{h.text}</a>
              </li>
            ))}
          </ul>
          <button type="button" data-copy-link class="mt-4 w-full h-9 rounded-full border border-border text-sm font-medium hover:bg-muted transition-colors">
            {t('blog.post.share')} · {t('common.copyLink')}
          </button>
        </div>
      </aside>

      <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-serif prose-a:text-primary prose-code:text-primary prose-pre:rounded-2xl" data-article-body data-copy-label={t('blog.post.copyCode')} data-copied-label={t('blog.post.copiedCode')}>
        <Content />
      </div>
    </div>

    <section class="mt-16" aria-label={t('blog.post.related')}>
      <h2 class="font-serif text-2xl md:text-3xl font-bold">{t('blog.post.related')}</h2>
      <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedLoc.map(({ r, loc }) => (
          <a href={getLocalizedPath(`/blog/${r.slug}`, lang)} class="rounded-2xl border border-border bg-card/60 overflow-hidden hover:border-sage-500/40 hover:shadow-lg transition-all">
            <img src={r.data.coverImage} alt={loc.title} class="h-36 w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="text-[11px] font-mono text-sage-600 dark:text-sage-400">{r.data.category}</p>
              <h3 class="mt-1.5 font-semibold leading-snug">{loc.title}</h3>
              <p class="mt-2 text-xs text-foreground/55">{r.data.pubDate.toISOString().slice(0, 10)} · {parseInt(r.data.readTime)} {t('common.minRead')}</p>
            </div>
          </a>
        ))}
      </div>
      <a href={getLocalizedPath('/blog', lang)} class="mt-8 inline-flex items-center gap-2 font-semibold text-sage-600 dark:text-sage-400">← {t('blog.post.backToBlog')}</a>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  // View-Transition safe: re-runs after every `astro:page-load` so code
  // copy buttons exist after client-side navigations. Guards prevent
  // duplicate buttons/listeners on double invocation.
  function setupArticleEnhancements() {
    var wrap = document.querySelector('[data-article-body]');
    if (!wrap) return;
    var copyLabel = (wrap && wrap.getAttribute('data-copy-label')) || 'Copy';
    var copiedLabel = (wrap && wrap.getAttribute('data-copied-label')) || 'Copied!';
    document.querySelectorAll('[data-article-body] pre').forEach(function (pre) {
      if (pre.querySelector('[data-copy-code]')) return;
      pre.style.position = 'relative';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-copy-code', '');
      btn.textContent = copyLabel;
      btn.style.cssText = 'position:absolute;top:8px;right:8px;font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid rgba(128,128,128,.35);background:rgba(0,0,0,.45);color:#fff;cursor:pointer;';
      btn.addEventListener('click', function () {
        var code = pre.querySelector('code');
        var text = code ? code.innerText : pre.innerText;
        function done() { btn.textContent = copiedLabel; setTimeout(function () { btn.textContent = copyLabel; }, 2000); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
      pre.appendChild(btn);
    });
    document.querySelectorAll('[data-copy-link]').forEach(function (btn) {
      if (btn.hasAttribute('data-wired')) return;
      btn.setAttribute('data-wired', 'true');
      var idleLabel = btn.textContent;
      btn.addEventListener('click', function () {
        var url = window.location.href;
        function done() {
          btn.textContent = copiedLabel;
          setTimeout(function () { btn.textContent = idleLabel; }, 2000);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(done);
        } else { done(); }
      });
    });
  }

  setupArticleEnhancements();
  document.addEventListener('astro:page-load', setupArticleEnhancements);
</script>
