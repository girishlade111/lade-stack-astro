---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import { localizePost, getContent, getLocalizedApps, getPostSlug, getBlogPostsForLocale } from '@/i18n/content';
import { nonDefaultLocales, languages, type SupportedLocale } from '@/i18n/config';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return nonDefaultLocales.flatMap((lang) => {
    const posts = getBlogPostsForLocale(lang, allPosts);
    return posts.map(({ post, isFallback, cleanSlug }) => ({
      params: { lang, slug: cleanSlug },
      props: { post, isFallback, cleanSlug },
    }));
  });
}

const { lang } = Astro.params as { lang: SupportedLocale };
const { post, isFallback, cleanSlug } = Astro.props as {
  post: CollectionEntry<'blog'>;
  isFallback: boolean;
  cleanSlug: string;
};

const t = useTranslations(lang);
const c = getContent(lang);
const currentLangMeta = languages[lang] ?? languages.en;
const loc = localizePost(cleanSlug, post.data, lang);
const { Content, headings } = await render(post);
type TocHeading = { depth: number; slug: string; text: string };
const toc: TocHeading[] = (headings as TocHeading[]).filter((h) => h.depth <= 3);

// lastmod prefers updatedDate (only set when edited post-publish) over pubDate.
const modifiedDate = post.data.updatedDate ?? post.data.pubDate;
const isoDate = post.data.pubDate.toISOString();
const isoModified = modifiedDate.toISOString();

// Related posts: score by shared category (+2) and overlapping tags (+1 each),
// newest first, excluding the current post, max 3.
const all: CollectionEntry<'blog'>[] = getBlogPostsForLocale(lang, await getCollection('blog')).map((e) => e.post);
const scored = all
  .filter((p) => getPostSlug(p) !== cleanSlug)
  .map((p) => {
    let score = 0;
    if (p.data.category === post.data.category) score += 2;
    score += p.data.tags.filter((tag: string) => post.data.tags.includes(tag)).length;
    return { p, score };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ p }) => p);
const relatedPool = scored.length ? scored : all.filter((p) => getPostSlug(p) !== cleanSlug).slice(0, 3);
const relatedLoc = relatedPool.map((r) => {
  const rSlug = getPostSlug(r);
  return { r, cleanSlug: rSlug, loc: localizePost(rSlug, r.data, lang) };
});

// Related tools: app IDs from frontmatter resolved via apps.json.
const relatedTools = getLocalizedApps(lang).filter((app) => (post.data.relatedApps ?? []).includes(app.id));

// Breadcrumb trail is emitted via SEO.astro `breadcrumbs` (single BreadcrumbList).
const breadcrumbs = [
  { name: 'Home', url: `https://ladestack.in${getLocalizedPath('/', lang)}` },
  { name: 'Blog', url: `https://ladestack.in${getLocalizedPath('/blog', lang)}` },
  { name: loc.title, url: `https://ladestack.in${getLocalizedPath(`/blog/${cleanSlug}`, lang)}` },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: loc.title,
    description: loc.description,
    image: `https://ladestack.in${post.data.coverImage}`,
    datePublished: isoDate,
    dateModified: isoModified,
    inLanguage: currentLangMeta.iso,
    author: { '@type': 'Person', name: post.data.author, url: 'https://ladestack.in/about' },
    publisher: { '@type': 'Organization', name: 'Lade Stack', logo: { '@type': 'ImageObject', url: 'https://ladestack.in/icon-512.png', width: 512, height: 512 } },
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://ladestack.in/${lang}/blog/${cleanSlug}` }
  },
];
---
<BaseLayout
  lang={lang}
  path={`/${lang}/blog/${cleanSlug}`}
  title={`${loc.title} | Lade Stack Blog`}
  description={loc.description}
  keywords={post.data.tags.join(', ')}
  ogType="article"
  ogImage={`https://ladestack.in${post.data.coverImage}`}
  article={{ publishedTime: isoDate, modifiedTime: isoModified, author: post.data.author, tags: post.data.tags }}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  hreflang={!isFallback}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-foreground/55">
      <a href={getLocalizedPath('/', lang)} class="hover:text-foreground">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={getLocalizedPath('/blog', lang)} class="hover:text-foreground">Blog</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-foreground/80">{c.blogCategories[post.data.category] ?? post.data.category}</span>
    </nav>

    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-4">
        {c.blogCategories[post.data.category] ?? post.data.category}
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-foreground leading-tight break-words">
        {loc.title}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
        {loc.description}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-muted-foreground">
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate}>
          {post.data.pubDate.toLocaleDateString(currentLangMeta.iso, { month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="text-primary font-mono text-[11px]">Updated {post.data.updatedDate.toISOString().slice(0, 10)}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{post.data.readTime} {t('common.minRead')}</span>
      </div>
    </div>

    <!-- Cover Image -->
    <div class="max-w-4xl mx-auto rounded-3xl overflow-hidden border border-border bg-card/60 shadow-xl mb-12">
      <Image
        src={post.data.coverImage}
        alt={`${loc.title} cover graphic`}
        width={1200}
        height={630}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto object-cover max-h-[440px]"
      />
    </div>

    <!-- Fallback Banner if untranslated copy -->
    {isFallback && (
      <div class="max-w-3xl mx-auto mb-10 p-4 sm:p-5 rounded-2xl border border-hairline-soft bg-canvas-soft/80 flex items-center gap-3.5 text-sm text-ash">
        <Icon name="lucide:globe" class="w-5 h-5 text-brand shrink-0" />
        <span>
          Available in English — {currentLangMeta.name} translation coming soon.
        </span>
      </div>
    )}

    <!-- Table of Contents -->
    {toc.length > 0 && (
      <nav aria-label="Table of contents" class="max-w-3xl mx-auto mb-12 p-6 rounded-2xl border border-border bg-card/40">
        <p class="font-mono text-xs text-primary mb-3 uppercase tracking-wider font-semibold">{t('blog.post.onThisPage')}</p>
        <ul class="space-y-2 text-sm">
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'ml-4' : ''}>
              <a href={`#${h.slug}`} class="text-muted-foreground hover:text-primary transition-colors">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Article Content -->
    <div class="prose prose-neutral dark:prose-invert max-w-3xl mx-auto prose-headings:font-serif prose-a:text-primary prose-img:rounded-2xl">
      <Content />
    </div>

    <!-- Social Share Bar (Vanilla JS, self-contained) -->
    <div class="max-w-3xl mx-auto mt-12 pt-8 border-t border-border/60 flex flex-wrap items-center justify-between gap-4">
      <span class="text-xs font-mono text-muted-foreground">{t('blog.post.share')}</span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-copy-link
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card/60 hover:bg-muted text-xs font-medium text-foreground transition-all"
        >
          <Icon name="lucide:link" class="w-3.5 h-3.5" />
          <span data-copy-label>{t('blog.post.copyLink')}</span>
        </button>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(loc.title)}&url=${encodeURIComponent(`https://ladestack.in/${lang}/blog/${cleanSlug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card/60 hover:bg-muted text-xs font-medium text-foreground transition-all"
          aria-label="Share on X"
        >
          <Icon name="lucide:share-2" class="w-3.5 h-3.5" />
          <span>X / Twitter</span>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://ladestack.in/${lang}/blog/${cleanSlug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-border bg-card/60 hover:bg-muted text-xs font-medium text-foreground transition-all"
          aria-label="Share on LinkedIn"
        >
          <Icon name="lucide:share-2" class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <!-- Related Tools Section (only if relatedApps present) -->
    {relatedTools.length > 0 && (
      <section class="mt-16 pt-12 border-t border-border/60" aria-label="Related developer tools">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold break-words">{c.appsHeading.title}</h2>
            <p class="text-sm text-muted-foreground mt-1">Production tools referenced in this article</p>
          </div>
          <a href={getLocalizedPath('/apps', lang)} class="text-xs font-semibold text-primary hover:underline">
            View all tools →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedTools.map((app) => (
            <a
              href={app.landingUrl ? (app.landingUrl.startsWith('http') ? app.landingUrl : getLocalizedPath(app.landingUrl, lang)) : getLocalizedPath('/apps', lang)}
              class="group rounded-2xl border border-border bg-card/60 p-5 hover:border-primary/40 hover:shadow-lg transition-all flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <Icon name={app.icon} class="w-5 h-5" />
                  </div>
                  <div>
                    <h3 class="font-semibold text-sm leading-tight group-hover:text-primary transition-colors">{app.title}</h3>
                    <span class="text-[11px] font-mono text-muted-foreground">{app.displayCategory}</span>
                  </div>
                </div>
                <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">{app.description}</p>
              </div>
              <span class="mt-4 text-xs font-semibold text-primary inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                {t('nav.launchApp')} <Icon name="lucide:external-link" class="w-3 h-3" />
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles -->
    <section class="mt-16" aria-label={t('blog.post.related')}>
      <h2 class="font-serif text-2xl md:text-3xl font-bold break-words">{t('blog.post.related')}</h2>
      <div class="mt-6 grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedLoc.map(({ r, cleanSlug: rSlug, loc }) => (
          <a href={`/${lang}/blog/${rSlug}`} class="rounded-2xl border border-border bg-card/60 overflow-hidden hover:border-primary/40 hover:shadow-lg transition-all">
            <Image src={r.data.coverImage} alt={`${loc.title} — related article cover`} width={600} height={216} loading="lazy" decoding="async" class="h-36 w-full object-cover" />
            <div class="p-5">
              <p class="text-[11px] font-mono text-primary">{r.data.category}</p>
              <h3 class="mt-1.5 font-semibold leading-snug">{loc.title}</h3>
              <p class="mt-2 text-xs text-foreground/55">{r.data.pubDate.toISOString().slice(0, 10)} · {r.data.readTime} {t('common.minRead')}</p>
            </div>
          </a>
        ))}
      </div>
      <a href={`/${lang}/blog`} class="mt-8 inline-flex items-center gap-2 font-semibold text-brand hover:underline">← {t('blog.post.backToBlog')}</a>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  function setupCopyLink() {
    var btn = document.querySelector('[data-copy-link]');
    var label = document.querySelector('[data-copy-label]');
    if (!btn || !label) return;
    btn.addEventListener('click', function () {
      var url = window.location.href;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(fallback);
      } else {
        fallback();
      }
      function fallback() {
        var input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(input);
        done();
      }
      function done() {
        var orig = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(function () { label.textContent = orig; }, 2000);
      }
    });
  }
  setupCopyLink();
  document.addEventListener('astro:page-load', setupCopyLink);
</script>
