---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import { localizePost, getContent, getBlogPostsForLocale, type LocaleBlogPost } from '@/i18n/content';
import { nonDefaultLocales, languages, type SupportedLocale } from '@/i18n/config';
import { getPageSEO } from '@/i18n/seo';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';
import type { GetStaticPaths, Page } from 'astro';

// 12 posts per page, newest first → /[lang]/blog (page 1), /[lang]/blog/2, /[lang]/blog/3, …
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allBlogPosts = await getCollection('blog');
  return nonDefaultLocales.flatMap((lang) => {
    const posts = getBlogPostsForLocale(lang, allBlogPosts);
    return paginate(posts, {
      params: { lang },
      pageSize: 12,
    });
  });
};

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
const c = getContent(lang);
const seo = getPageSEO('blogListing', lang);
const currentLangMeta = languages[lang] ?? languages.en;
const { page } = Astro.props as { page: Page<LocaleBlogPost> };

// Full sorted list (for category pills) — page.data holds only the current slice.
const allBlogPosts = await getCollection('blog');
const allSorted = getBlogPostsForLocale(lang, allBlogPosts).map((e) => e.post);

const categories = ['All', ...new Set(allSorted.map((p) => p.data.category))];
const gridPosts = page.data.map(({ post, cleanSlug, isFallback }) => ({
  post,
  cleanSlug,
  isFallback,
  loc: localizePost(cleanSlug, post.data, lang),
}));

const SITE_URL = 'https://ladestack.in';
const canonicalPath = page.currentPage === 1 ? `/${lang}/blog` : `/${lang}/blog/${page.currentPage}`;
const prevUrl = page.url.prev ? `${SITE_URL}${page.url.prev}` : undefined;
const nextUrl = page.url.next ? `${SITE_URL}${page.url.next}` : undefined;
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? `/${lang}/blog` : `/${lang}/blog/${n}`);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: seo.title,
    url: `${SITE_URL}${canonicalPath}`,
    inLanguage: lang,
    description: seo.description,
    publisher: { '@type': 'Organization', name: 'Lade Stack', url: SITE_URL }
  }
];

// Breadcrumb trail is emitted via SEO.astro `breadcrumbs` (single BreadcrumbList).
// getLocalizedPath() keeps item URLs locale-prefixed (e.g. /zh, /zh/blog).
const breadcrumbs = [
  { name: t('nav.home'), url: `${SITE_URL}${getLocalizedPath('/', lang)}` },
  { name: seo.breadcrumbName, url: `${SITE_URL}${getLocalizedPath('/blog', lang)}` },
];
---

<BaseLayout
  title={`${seo.title} — Page ${page.currentPage} | Lade Stack`}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  lang={lang}
  path={page.currentPage === 1 ? '/blog' : `/blog/${page.currentPage}`}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <div class="marketing-section-dark">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <MonoEyebrow color="brand" class="mb-3">INSIGHTS</MonoEyebrow>
        <h1 class="display-md text-on-primary mb-4 break-words page-enter rise-in">
          {t('blog.heading')}
        </h1>
        <p class="subtitle text-ash mb-8">
          {t('blog.subtitle')}
        </p>
        {gridPosts.some(p => p.isFallback) && (
          <p class="caption text-ash mb-4">
            Available in English — {currentLangMeta.name} translations in progress
          </p>
        )}

        <!-- Real-time Search Input (Vanilla JS, filters this page) -->
        <div class="mt-8 relative max-w-md mx-auto">
          <Icon name="lucide:search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ash pointer-events-none" />
          <input
            type="text"
            id="blog-search-input"
            aria-label={t('blog.searchPlaceholder')}
            placeholder={t('blog.searchPlaceholder')}
            class="text-input-dark w-full !pl-11 pr-4"
          />
        </div>

        <!-- Category Filter Pills using btn-app-tab tokens -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="category-pills" role="group" aria-label={t('blog.filterLabel')}>
          {
            categories.map((cat, idx) => (
              <button
                type="button"
                aria-pressed={idx === 0 ? 'true' : 'false'}
                class={`category-pill btn-app-tab !h-8 !px-3 cursor-pointer ${idx === 0 ? 'active' : ''}`}
                data-category={cat}
              >
                {cat === 'All' ? t('blog.allCategories') : (c.blogCategories[cat] ?? cat)}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="articles-grid">
        {
          gridPosts.map(({ post, cleanSlug, isFallback, loc }, index) => (
            <div
              class="article-card flex"
              data-category={post.data.category}
              data-title={loc.title.toLowerCase()}
              data-desc={loc.description.toLowerCase()}
              data-reveal
              data-reveal-delay={String((index % 6) * 80)}
            >
              <FeatureCard variant="dark" class="flex flex-col justify-between w-full hover:border-graphite transition-colors lift-on-hover">
                <div>
                  <div class="flex items-center justify-between mb-6">
                    <span class="mono-micro px-2 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">
                      {c.blogCategories[post.data.category] ?? post.data.category}
                    </span>
                    <div class="flex items-center gap-2">
                      {isFallback && (
                        <span class="mono-micro px-2 py-0.5 rounded-full bg-canvas-soft border border-hairline-soft text-ash" title="English original">
                          EN
                        </span>
                      )}
                      <span class="caption text-ash">{post.data.readTime} {t('common.minRead')}</span>
                    </div>
                  </div>
                  <h2 class="heading-sm text-on-primary mb-2 break-words">
                    <a href={`/${lang}/blog/${cleanSlug}`} class="hover:text-brand transition-colors">
                      {loc.title}
                    </a>
                  </h2>
                  <p class="body-sm text-ash leading-relaxed line-clamp-3 mb-6">
                    {loc.description}
                  </p>
                </div>

                <div class="mt-auto pt-6 border-t border-hairline-soft flex items-center justify-between flex-wrap gap-2">
                  <span class="caption text-ash">{post.data.pubDate.toLocaleDateString(currentLangMeta.hreflang, { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <Button
                    href={`/${lang}/blog/${cleanSlug}`}
                    variant="secondary-dark"
                    class="!h-8 !px-3 text-xs group"
                  >
                    <span>{t('blog.readArticle')}</span>
                    <Icon name="lucide:arrow-right" class="w-3 h-3 ml-1.5 group-hover:translate-x-0.5 transition-transform" />
                  </Button>
                </div>
              </FeatureCard>
            </div>
          ))
        }
      </div>
      <div aria-live="polite"><p data-blog-empty class="hidden mt-8 text-center caption text-ash">{t('blog.noMatch')}</p></div>
      <p
        data-blog-count
        class="sr-only"
        aria-live="polite"
        data-count-one={t('blog.countOne')}
        data-count-other={t('blog.countOther')}
      ></p>

      <!-- Pagination Controls -->
      {page.lastPage > 1 && (
        <nav aria-label="Blog pagination" class="mt-16 flex items-center justify-center gap-2 flex-wrap" data-reveal>
          {page.url.prev ? (
            <Button
              href={page.url.prev}
              rel="prev"
              variant="secondary-dark"
              class="!h-9 !px-3.5 !text-xs"
            >
              ← {t('common.previous')}
            </Button>
          ) : (
            <Button
              variant="secondary-dark"
              class="!h-9 !px-3.5 !text-xs opacity-40 cursor-not-allowed"
              disabled
              aria-disabled="true"
            >
              ← {t('common.previous')}
            </Button>
          )}
          {pageNumbers.map((n) => (
            n === page.currentPage ? (
              <Button
                variant="primary"
                class="!h-9 !px-3.5 !text-xs font-semibold"
                aria-current="page"
              >
                {n}
              </Button>
            ) : (
              <Button
                href={pageHref(n)}
                aria-label={`Go to page ${n}`}
                variant="secondary-dark"
                class="!h-9 !px-3.5 !text-xs"
              >
                {n}
              </Button>
            )
          ))}
          {page.url.next ? (
            <Button
              href={page.url.next}
              rel="next"
              variant="secondary-dark"
              class="!h-9 !px-3.5 !text-xs"
            >
              {t('common.next')} →
            </Button>
          ) : (
            <Button
              variant="secondary-dark"
              class="!h-9 !px-3.5 !text-xs opacity-40 cursor-not-allowed"
              disabled
              aria-disabled="true"
            >
              {t('common.next')} →
            </Button>
          )}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  function setupBlogSearch(): void {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.article-card');
    const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
    const counter = document.querySelector<HTMLElement>('[data-blog-count]');

    let currentCategory = 'All';
    let currentQuery = '';

    function filterPosts(): void {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesCat = currentCategory === 'All' || cat === currentCategory;
        const matchesQuery =
          currentQuery === '' || title.includes(currentQuery) || desc.includes(currentQuery);

        card.style.display = matchesCat && matchesQuery ? 'flex' : 'none';
        if (matchesCat && matchesQuery) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      if (counter) {
        const oneText = counter.getAttribute('data-count-one') || '1 article shown.';
        const otherText = counter.getAttribute('data-count-other') || '{n} articles shown.';
        counter.textContent = visible === 1 ? oneText : otherText.replace('{n}', String(visible));
      }
    }

    if (input) {
      input.addEventListener('input', (e: Event) => {
        currentQuery = ((e.target as HTMLInputElement).value || '').toLowerCase().trim();
        filterPosts();
      });
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-pressed', 'true');

        currentCategory = pill.getAttribute('data-category') || 'All';
        filterPosts();
      });
    });
  }

  setupBlogSearch();
  document.addEventListener('astro:page-load', setupBlogSearch);
</script>

<style>
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
