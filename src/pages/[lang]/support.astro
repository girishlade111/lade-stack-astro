---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { nonDefaultLocales, type SupportedLocale } from '../../i18n/config';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);

const faqs = [
  { q: 'A tool is not loading. What should I do?', a: 'Hard-refresh, disable aggressive ad-blockers for ladestack.in, and try a recent browser.' },
  { q: 'Are my files uploaded anywhere?', a: 'No. Core tools run fully client-side.' },
  { q: 'How do I report a bug?', a: 'Email admin@ladestack.in with the tool name and steps to reproduce.' },
  { q: 'Can I suggest a new tool?', a: 'Yes — community requests drive the roadmap.' },
  { q: 'Where do I learn best practices?', a: 'Start with the Docs and the Blog guides.' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: 'Lade Stack Support',
  url: 'https://ladestack.in/support',
  inLanguage: lang,
  description: t('support.subtitle'),
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
---
<BaseLayout lang={lang} path="/support" title={`${t('support.title')} | Lade Stack`} description={t('support.subtitle')} structuredData={structuredData}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-6xl font-bold">Support</h1>
    <p class="mt-3 text-foreground/65 max-w-2xl md:text-lg">{t('support.subtitle')}</p>
    <div class="mt-8 grid lg:grid-cols-2 gap-3 items-start">
      {faqs.map((f) => (
        <details class="rounded-2xl border border-border bg-card/60 px-5 py-4 open:border-sage-500/40">
          <summary class="cursor-pointer font-medium list-none flex items-center justify-between gap-3">
            {f.q}
            <span aria-hidden="true" class="text-sage-500 text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-sm text-foreground/65 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-10 rounded-3xl bg-sage-500 text-white p-8 text-center">
      <h2 class="font-serif text-2xl font-bold">Still stuck?</h2>
      <a href={getLocalizedPath('/contact', lang)} class="mt-5 inline-flex h-11 px-7 items-center justify-center rounded-full bg-white text-sage-700 font-semibold">{t('contact.title')}</a>
    </div>
  </div>
</BaseLayout>
