---
import BaseLayout from '@/layouts/BaseLayout.astro';
import appsData from '@/data/apps.json';
import { useTranslations } from '@/i18n/utils';
import { nonDefaultLocales, type SupportedLocale } from '@/i18n/config';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<BaseLayout
  title="Apps Administration Dashboard | Lade Stack"
  description="Internal tool for editing the apps gallery database."
  lang={lang}
  path="/apps/admin"
  noIndex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8 pb-6 border-b border-border">
      <div>
        <h1 class="font-serif text-3xl font-bold text-foreground">{t('admin.title')}</h1>
        <p class="text-sm text-muted-foreground mt-1">{t('admin.subtitle')}</p>
      </div>
      <button
        id="export-json-btn"
        class="px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary/90 transition-all shadow-sm"
      >
        {t('admin.export')}
      </button>
    </div>
    <p data-admin-status class="hidden mb-6 text-sm text-emerald-600 dark:text-emerald-400" role="status"></p>

    <!-- Form for adding app -->
    <div class="p-8 rounded-3xl border border-border bg-card mb-12">
      <h2 class="text-lg font-bold text-foreground mb-6">{t('admin.newTitle')}</h2>
      <form id="add-app-form" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-2" for="app-title">{t('admin.formTitle')}</label>
          <input type="text" id="app-title" required class="w-full px-3.5 py-2 rounded-xl border border-border bg-background text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-foreground mb-2" for="app-tagline">{t('admin.formTagline')}</label>
          <input type="text" id="app-tagline" required class="w-full px-3.5 py-2 rounded-xl border border-border bg-background text-sm" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-foreground mb-2" for="app-desc">{t('admin.formDesc')}</label>
          <textarea id="app-desc" rows="3" required class="w-full px-3.5 py-2 rounded-xl border border-border bg-background text-sm"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-foreground mb-2" for="app-category">{t('admin.formCategory')}</label>
          <input type="text" id="app-category" placeholder="AI Tools" required class="w-full px-3.5 py-2 rounded-xl border border-border bg-background text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-foreground mb-2" for="app-url">Landing URL</label>
          <input type="text" id="app-url" placeholder="/my-app, https://... (empty = Coming Soon)" class="w-full px-3.5 py-2 rounded-xl border border-border bg-background text-sm" />
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="px-6 py-2.5 rounded-xl border border-border bg-card hover:bg-muted text-foreground font-semibold text-sm">
            {t('admin.add')}
          </button>
        </div>
      </form>
    </div>

    <!-- Raw JSON Preview -->
    <div class="p-6 rounded-3xl border border-border bg-muted/40">
      <h3 class="text-sm font-semibold text-foreground mb-3">{t('admin.preview')}</h3>
      <pre id="json-preview" class="p-4 rounded-2xl bg-card border border-border font-mono text-xs overflow-x-auto text-foreground max-h-96">{JSON.stringify(appsData, null, 2)}</pre>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ initialApps: appsData, msgAdded: t('admin.added'), msgCopied: t('admin.copied') }}>
  /** @param {string} id @returns {HTMLInputElement | HTMLTextAreaElement | null} */
  function field(id) {
    return /** @type {HTMLInputElement | HTMLTextAreaElement | null} */ (document.getElementById(id));
  }
  /** @param {string} text @returns {void} */
  function status(text) {
    var el = document.querySelector('[data-admin-status]');
    if (!el) return;
    el.textContent = text;
    el.classList.remove('hidden');
    window.setTimeout(function () { el.classList.add('hidden'); }, 5000);
  }

  /** @type {Array<Record<string, unknown>>} */
  var apps = Array.isArray(initialApps) ? initialApps.slice() : [];
  var form = document.getElementById('add-app-form');
  var preview = document.getElementById('json-preview');
  var exportBtn = document.getElementById('export-json-btn');

  function updatePreview() {
    if (preview) preview.innerText = JSON.stringify(apps, null, 2);
  }

  if (form && form instanceof HTMLFormElement) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var titleEl = field('app-title');
      var taglineEl = field('app-tagline');
      var descEl = field('app-desc');
      var catEl = field('app-category');
      var urlEl = field('app-url');
      if (!titleEl || !taglineEl || !descEl || !catEl || !urlEl) return;
      var title = titleEl.value.trim();
      if (!title) return;

      var urlVal = urlEl.value.trim();
      var slug = title.toLowerCase().replace(/\s+/g, '-');
      var newApp = {
        id: slug,
        slug: slug,
        title: title,
        tagline: taglineEl.value.trim(),
        description: descEl.value.trim(),
        icon: 'lucide:box',
        category: catEl.value.trim() || 'AI Tools',
        features: ['Fast', 'Free'],
        timeToValue: 'Instant',
        integrations: ['Web'],
        lifetimeFree: true,
        iconAlt: title + ' icon',
        popularityScore: 50,
      };
      if (urlVal) {
        newApp.landingUrl = urlVal;
      } else {
        newApp.comingSoon = true;
      }

      apps.push(newApp);
      updatePreview();
      form.reset();
      status(msgAdded);
    });
  }

  if (exportBtn) {
    exportBtn.addEventListener('click', function () {
      // B14: block export of malformed entries (mirrors appsSchema in content.ts).
      var bad = -1;
      var req = ['id', 'slug', 'title', 'tagline', 'description', 'icon', 'category'];
      for (var i = 0; i < apps.length; i++) {
        var a = apps[i] || {};
        var ok = req.every(function (k) { return typeof a[k] === 'string' && a[k].trim(); });
        if (a.landingUrl != null && typeof a.landingUrl !== 'string') ok = false;
        if (a.comingSoon != null && typeof a.comingSoon !== 'boolean') ok = false;
        if (!ok) { bad = i; break; }
      }
      if (bad !== -1) {
        status('Entry #' + (bad + 1) + ' is invalid — fix required fields before exporting.');
        return;
      }
      var payload = JSON.stringify(apps, null, 2);
      function done() {
        status(msgCopied);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(payload).then(done).catch(done);
      } else {
        done();
      }
    });
  }
</script>
