---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../i18n/content';
import { getPageSEO, createBreadcrumbSchema } from '../i18n/seo';

const lang = 'en' as const;
const c = getContent(lang);
const seo = getPageSEO('terms', lang);
const updated = '2026-09-09';
const sections = c.terms;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: seo.title,
    url: 'https://ladestack.in/terms',
    description: seo.description,
  },
  createBreadcrumbSchema([
    { name: 'Home', url: 'https://ladestack.in/' },
    { name: seo.breadcrumbName, url: 'https://ladestack.in/terms' },
  ]),
];
---
<BaseLayout
  lang={lang}
  path="/terms"
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  structuredData={structuredData}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-5xl font-bold break-words">Terms of Service</h1>
    <p class="mt-3 text-sm text-foreground/55">Last updated: {updated}</p>
    <div class="mt-8 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="font-serif text-xl md:text-2xl font-bold break-words">{s.h}</h2>
          <p class="mt-2 text-foreground/70 leading-relaxed break-words">{s.p}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
