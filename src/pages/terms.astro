---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../i18n/content';

const lang = 'en' as const;
const c = getContent(lang);
const updated = '2026-09-09';
const sections = c.terms;
---
<BaseLayout
  lang={lang}
  path="/terms"
  title="Terms of Service — Free-Use License & Rules | Lade Stack"
  description="Lade Stack terms of service: free license for personal & commercial use, acceptable use, fair-use quotas, warranties and liability limits."
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Service — Lade Stack',
    url: 'https://ladestack.in/terms',
    description: 'Lade Stack terms: free-use license, acceptable use, and liability limits.',
  }}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-5xl font-bold break-words">Terms of Service</h1>
    <p class="mt-3 text-sm text-foreground/55">Last updated: {updated}</p>
    <div class="mt-8 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="font-serif text-xl md:text-2xl font-bold break-words">{s.h}</h2>
          <p class="mt-2 text-foreground/70 leading-relaxed break-words">{s.p}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
