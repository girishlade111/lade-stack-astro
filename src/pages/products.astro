---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductsSection from '@/components/sections/ProductsSection.astro';
import { useTranslations } from '@/i18n/utils';
import { getPageSEO, createBreadcrumbSchema } from '@/i18n/seo';

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const seo = getPageSEO('products', defaultLang);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seo.title,
    url: 'https://ladestack.in/products',
    description: seo.description,
    mainEntity: [
      {
        '@type': 'SoftwareApplication',
        name: 'CodeEnhance AI',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: 'https://ladestack.in/ai-code-viewer-ai',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'API Testing Platform',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: 'https://ladestack.in/products',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'Website Builder AI',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: 'https://ladestack.in/products',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      },
      {
        '@type': 'SoftwareApplication',
        name: 'Secure File Hub',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web Browser',
        url: 'https://ladestack.in/products',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
      }
    ]
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: 'https://ladestack.in/' },
    { name: seo.breadcrumbName, url: 'https://ladestack.in/products' },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  lang={defaultLang}
  path="/products"
  structuredData={structuredData}
>
  <ProductsSection lang="en" isPage={true} />
</BaseLayout>

