---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.slug !== featured?.slug);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Lade Stack Blog',
  url: 'https://ladestack.in/blog',
  description: t('blog.subtitle'),
  publisher: { '@type': 'Organization', name: 'Lade Stack', url: 'https://ladestack.in' }
};
---
<BaseLayout
  lang={lang}
  path="/blog"
  title="Blog – AI Development Insights & Tutorials | Lade Stack"
  description="Explore the latest insights, tutorials, and trends in AI software development, API testing, and developer productivity from the Lade Stack team."
  keywords="AI blog, developer tutorials, RAG, MLOps, SaaS architecture, DevOps"
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-6xl font-bold">Blog</h1>
    <p class="mt-3 text-foreground/65 max-w-2xl md:text-lg">{t('blog.subtitle')}</p>

    <!-- Search + categories -->
    <div class="mt-8 flex flex-col md:flex-row gap-3 md:items-center">
      <input
        type="search"
        data-blog-search
        placeholder={t('blog.searchPlaceholder')}
        aria-label={t('blog.searchPlaceholder')}
        class="h-11 px-4 rounded-full border border-border bg-card text-sm outline-none focus:border-sage-500 w-full md:max-w-xs"
      />
      <div class="flex flex-wrap gap-2" data-category-pills role="group" aria-label={t('common.category')}>
        <button type="button" data-category="all" class="h-9 px-4 rounded-full text-sm font-medium bg-sage-500 text-white" aria-pressed="true">{t('blog.allCategories')}</button>
        {categories.map((c) => (
          <button type="button" data-category={c} class="h-9 px-4 rounded-full text-sm font-medium border border-border hover:bg-muted transition-colors" aria-pressed="false">{c}</button>
        ))}
      </div>
    </div>

    <!-- Featured -->
    {featured && (
      <a href={getLocalizedPath(`/blog/${featured.slug}`, lang)} data-post-card data-category-value={featured.data.category} data-search-text={`${featured.data.title} ${featured.data.description} ${featured.data.category} ${featured.data.tags.join(' ')}`.toLowerCase()} class="mt-8 grid md:grid-cols-2 gap-6 rounded-3xl border border-border bg-card/60 overflow-hidden hover:border-sage-500/40 hover:shadow-xl transition-all">
        <img src={featured.data.coverImage} alt={featured.data.title} class="h-56 md:h-full w-full object-cover" loading="eager" />
        <div class="p-6 md:p-10 flex flex-col justify-center">
          <p class="flex items-center gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 rounded-full bg-sage-500/15 text-sage-600 dark:text-sage-400">{t('common.featured')}</span>
            <span class="text-foreground/60">{featured.data.category}</span>
          </p>
          <h2 class="mt-3 font-serif text-2xl md:text-4xl font-bold leading-tight">{featured.data.title}</h2>
          <p class="mt-3 text-foreground/65">{featured.data.description}</p>
          <p class="mt-4 text-xs text-foreground/55">{featured.data.pubDate.toISOString().slice(0, 10)} · {featured.data.readTime}</p>
        </div>
      </a>
    )}

    <!-- Grid -->
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-post-grid>
      {rest.map((post) => (
        <a href={getLocalizedPath(`/blog/${post.slug}`, lang)} data-post-card data-category-value={post.data.category} data-search-text={`${post.data.title} ${post.data.description} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()} class="rounded-2xl border border-border bg-card/60 overflow-hidden hover:border-sage-500/40 hover:shadow-lg transition-all flex flex-col">
          <img src={post.data.coverImage} alt={post.data.title} class="h-40 w-full object-cover" loading="lazy" />
          <div class="p-5 flex flex-col flex-1">
            <p class="text-[11px] font-mono text-sage-600 dark:text-sage-400">{post.data.category}</p>
            <h3 class="mt-2 font-semibold leading-snug">{post.data.title}</h3>
            <p class="mt-2 text-sm text-foreground/60 line-clamp-2 flex-1">{post.data.description}</p>
            <p class="mt-3 text-xs text-foreground/55">{post.data.pubDate.toISOString().slice(0, 10)} · {post.data.readTime}</p>
          </div>
        </a>
      ))}
    </div>
    <p data-no-results class="hidden mt-8 text-center text-foreground/60">{t('common.noResults')}</p>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var search = document.querySelector('[data-blog-search]');
    var pills = Array.prototype.slice.call(document.querySelectorAll('[data-category-pills] [data-category]'));
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-post-card]'));
    var empty = document.querySelector('[data-no-results]');
    var activeCategory = 'all';

    function apply() {
      var q = search && search.value ? search.value.trim().toLowerCase() : '';
      var visible = 0;
      cards.forEach(function (card) {
        var cat = card.getAttribute('data-category-value') || '';
        var text = card.getAttribute('data-search-text') || '';
        var okCat = activeCategory === 'all' || cat === activeCategory;
        var okQuery = !q || text.indexOf(q) !== -1;
        var show = okCat && okQuery;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    }

    if (search) search.addEventListener('input', apply);
    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        activeCategory = pill.getAttribute('data-category') || 'all';
        pills.forEach(function (p) {
          var on = p === pill;
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
          p.className = on
            ? 'h-9 px-4 rounded-full text-sm font-medium bg-sage-500 text-white'
            : 'h-9 px-4 rounded-full text-sm font-medium border border-border hover:bg-muted transition-colors';
        });
        apply();
      });
    });
  })();
</script>

<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
