---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations } from '@/i18n/utils';
import { localizePost, getContent } from '@/i18n/content';
import Icon from '@/components/Icon.astro';
import type { GetStaticPaths, Page } from 'astro';

// 12 posts per page, newest first → /blog (page 1), /blog/2, /blog/3, …
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = (await getCollection('blog')).sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(allPosts, { pageSize: 12 });
};

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const c = getContent(defaultLang);
const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };

// Full sorted list (for category pills) — page.data holds only the current slice.
const allSorted: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = ['All', ...new Set(allSorted.map((p) => p.data.category))];
const gridPosts = page.data.map((post) => ({ post, loc: localizePost(post.slug, post.data, defaultLang) }));

const SITE_URL = 'https://ladestack.in';
const canonicalPath = page.currentPage === 1 ? '/blog' : `/blog/${page.currentPage}`;
const prevUrl = page.url.prev ? `${SITE_URL}${page.url.prev}` : undefined;
const nextUrl = page.url.next ? `${SITE_URL}${page.url.next}` : undefined;
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageHref = (n: number) => (n === 1 ? '/blog' : `/blog/${n}`);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Lade Stack Blog',
  url: `${SITE_URL}${canonicalPath}`,
  description: 'Expert tutorials, guides, and insights on AI-powered development, API testing, and modern software engineering.',
  publisher: { '@type': 'Organization', name: 'Lade Stack', url: SITE_URL }
};
---

<BaseLayout
  title={page.currentPage === 1 ? 'Engineering & AI Development Blog — Page 1 | Lade Stack' : `Engineering & AI Development Blog — Page ${page.currentPage} | Lade Stack`}
  description={page.currentPage === 1 ? `27 in-depth tutorials on AI development, RAG, MLOps & SaaS architecture — page 1 of ${page.lastPage}.` : `More AI development tutorials, RAG guides & SaaS blueprints — page ${page.currentPage} of ${page.lastPage}.`}
  keywords="AI blog, developer tutorials, RAG, MLOps, SaaS architecture, DevOps"
  lang={defaultLang}
  path={canonicalPath}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  hreflang={false}
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-foreground break-words">
        Engineering Insights
      </h1>
      <p class="mt-4 text-base sm:text-lg text-muted-foreground">
        Deep dives into AI systems, scalable SaaS architecture, and developer productivity.
      </p>
      <p class="mt-3 text-xs font-mono text-muted-foreground">Available in English</p>

      <!-- Real-time Search Input (Vanilla JS, filters this page) -->
      <div class="mt-8 relative max-w-md mx-auto">
        <Icon name="lucide:search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
        <input
          type="text"
          id="blog-search-input"
          aria-label="Search blog posts"
          placeholder="Search articles by title or keyword..."
          class="w-full pl-11 pr-4 py-3 rounded-2xl border border-border bg-card/60 text-sm focus:outline-none focus:ring-2 focus:ring-primary shadow-sm"
        />
      </div>

      <!-- Category Filter Pills (Vanilla JS) -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="category-pills">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              aria-pressed={idx === 0 ? 'true' : 'false'}
              class={`category-pill px-4 py-1.5 rounded-full text-xs font-semibold border transition-all ${
                idx === 0
                  ? 'bg-primary text-primary-foreground border-primary active-pill'
                  : 'bg-card border-border text-muted-foreground hover:bg-muted'
              }`}
              data-category={cat}
            >
              {c.blogCategories[cat] ?? cat}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" id="articles-grid">
      {
        gridPosts.map(({ post, loc }) => (
          <article
            class="article-card group p-6 rounded-3xl border border-border bg-card hover:border-primary/50 transition-all flex flex-col justify-between"
            data-category={post.data.category}
            data-title={loc.title.toLowerCase()}
            data-desc={loc.description.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between text-xs text-muted-foreground mb-4">
                <span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary font-semibold">
                  {c.blogCategories[post.data.category] ?? post.data.category}
                </span>
                <span>{post.data.readTime} {t('common.minRead')}</span>
              </div>
              <h2 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors leading-snug break-words">
                <a href={`/blog/${post.slug}`}>
                  {loc.title}
                </a>
              </h2>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed line-clamp-3">
                {loc.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between text-xs text-muted-foreground">
              <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              <span class="font-semibold text-primary inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Read article <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </span>
            </div>
          </article>
        ))
      }
    </div>
    <div aria-live="polite"><p data-blog-empty class="hidden mt-8 text-center text-muted-foreground">No articles match your search.</p></div>
    <p data-blog-count class="sr-only" aria-live="polite"></p>

    <!-- Pagination Controls -->
    {page.lastPage > 1 && (
      <nav aria-label="Blog pagination" class="mt-12 flex items-center justify-center gap-2 flex-wrap">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            rel="prev"
            class="px-4 py-2 rounded-full text-xs font-semibold border bg-card border-border text-muted-foreground hover:bg-muted transition-all"
          >
            ← Prev
          </a>
        ) : (
          <span
            aria-disabled="true"
            class="px-4 py-2 rounded-full text-xs font-semibold border bg-card border-border text-muted-foreground/40 cursor-not-allowed"
          >
            ← Prev
          </span>
        )}
        {pageNumbers.map((n) => (
          <a
            href={pageHref(n)}
            aria-label={`Go to page ${n}`}
            aria-current={n === page.currentPage ? 'page' : undefined}
            class={`px-4 py-2 rounded-full text-xs font-semibold border transition-all ${
              n === page.currentPage
                ? 'bg-primary text-primary-foreground border-primary'
                : 'bg-card border-border text-muted-foreground hover:bg-muted'
            }`}
          >
            {n}
          </a>
        ))}
        {page.url.next ? (
          <a
            href={page.url.next}
            rel="next"
            class="px-4 py-2 rounded-full text-xs font-semibold border bg-card border-border text-muted-foreground hover:bg-muted transition-all"
          >
            Next →
          </a>
        ) : (
          <span
            aria-disabled="true"
            class="px-4 py-2 rounded-full text-xs font-semibold border bg-card border-border text-muted-foreground/40 cursor-not-allowed"
          >
            Next →
          </span>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  function setupBlogSearch(): void {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.article-card');
    const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
    const counter = document.querySelector<HTMLElement>('[data-blog-count]');

    let currentCategory = 'All';
    let currentQuery = '';

    function filterPosts(): void {
      let visible = 0;
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesCat = currentCategory === 'All' || cat === currentCategory;
        const matchesQuery =
          currentQuery === '' || title.includes(currentQuery) || desc.includes(currentQuery);

        card.style.display = matchesCat && matchesQuery ? 'flex' : 'none';
        if (matchesCat && matchesQuery) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      if (counter) counter.textContent = `${visible} article${visible === 1 ? '' : 's'} shown.`;
    }

    if (input) {
      input.addEventListener('input', (e: Event) => {
        currentQuery = ((e.target as HTMLInputElement).value || '').toLowerCase().trim();
        filterPosts();
      });
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary', 'active-pill');
          p.classList.add('bg-card', 'text-muted-foreground');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('bg-primary', 'text-primary-foreground', 'border-primary', 'active-pill');
        pill.classList.remove('bg-card', 'text-muted-foreground');
        pill.setAttribute('aria-pressed', 'true');

        currentCategory = pill.getAttribute('data-category') || 'All';
        filterPosts();
      });
    });
  }

  setupBlogSearch();
  document.addEventListener('astro:page-load', setupBlogSearch);
</script>

<style>
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
