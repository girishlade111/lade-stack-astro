---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { localizePost, getContent, getLocalizedApps, getPostSlug, getBlogPostsForLocale } from '../../i18n/content';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
  const enPosts = getBlogPostsForLocale('en', allPosts);
  return enPosts.map(({ post, cleanSlug }) => ({
    params: { slug: cleanSlug },
    props: { post, cleanSlug }
  }));
}

const lang = 'en' as const;
const t = useTranslations(lang);
const c = getContent(lang);
const { post, cleanSlug: propsSlug } = Astro.props as { post: CollectionEntry<'blog'>; cleanSlug?: string };
const cleanSlug = propsSlug ?? getPostSlug(post);
const loc = localizePost(cleanSlug, post.data, lang);
const { Content, headings } = await render(post);
type TocHeading = { depth: number; slug: string; text: string };
const toc: TocHeading[] = (headings as TocHeading[]).filter((h) => h.depth <= 3);

// lastmod prefers updatedDate (only set when edited post-publish) over pubDate.
const modifiedDate = post.data.updatedDate ?? post.data.pubDate;
const isoDate = post.data.pubDate.toISOString();
const isoModified = modifiedDate.toISOString();

// Related posts: score by shared category (+2) and overlapping tags (+1 each),
// newest first, excluding the current post, max 3.
const all: CollectionEntry<'blog'>[] = getBlogPostsForLocale(lang, await getCollection('blog')).map((e) => e.post);
const scored = all
  .filter((p) => getPostSlug(p) !== cleanSlug)
  .map((p) => {
    let score = 0;
    if (p.data.category === post.data.category) score += 2;
    score += p.data.tags.filter((tag: string) => post.data.tags.includes(tag)).length;
    return { p, score };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ p }) => p);
const relatedPool = scored.length ? scored : all.filter((p) => getPostSlug(p) !== cleanSlug).slice(0, 3);
const relatedLoc = relatedPool.map((r) => {
  const rSlug = getPostSlug(r);
  return { r, cleanSlug: rSlug, loc: localizePost(rSlug, r.data, lang) };
});

// Related tools: app IDs from frontmatter resolved via apps.json (English copy).
const relatedTools = getLocalizedApps(lang).filter((app) => (post.data.relatedApps ?? []).includes(app.id));

// Breadcrumb trail is emitted via SEO.astro `breadcrumbs` (single BreadcrumbList).
const breadcrumbs = [
  { name: t('nav.home'), url: `https://ladestack.in${getLocalizedPath('/', lang)}` },
  { name: t('nav.blog'), url: `https://ladestack.in${getLocalizedPath('/blog', lang)}` },
  { name: loc.title, url: `https://ladestack.in${getLocalizedPath(`/blog/${cleanSlug}`, lang)}` },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: loc.title,
    description: loc.description,
    image: `https://ladestack.in${post.data.coverImage}`,
    datePublished: isoDate,
    dateModified: isoModified,
    inLanguage: 'en-US',
    author: { '@type': 'Person', name: post.data.author, url: 'https://ladestack.in/about' },
    publisher: { '@type': 'Organization', name: 'Lade Stack', logo: { '@type': 'ImageObject', url: 'https://ladestack.in/icon-512.png', width: 512, height: 512 } },
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://ladestack.in/blog/${cleanSlug}` }
  },
];
---
<BaseLayout
  lang={lang}
  path={`/blog/${cleanSlug}`}
  title={`${loc.title} | Lade Stack Blog`}
  description={loc.description}
  keywords={post.data.tags.join(', ')}
  ogType="article"
  ogImage={`https://ladestack.in${post.data.coverImage}`}
  article={{ publishedTime: isoDate, modifiedTime: isoModified, author: post.data.author, tags: post.data.tags }}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <div class="marketing-section-dark">
    <article class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mono-caps text-ash mb-8">
        <a href={getLocalizedPath('/', lang)} class="hover:text-on-primary transition-colors">{t('nav.home')}</a>
        <span aria-hidden="true" class="text-hairline-soft mx-2">/</span>
        <a href={getLocalizedPath('/blog', lang)} class="hover:text-on-primary transition-colors">{t('nav.blog')}</a>
        <span aria-hidden="true" class="text-hairline-soft mx-2">/</span>
        <span aria-current="page" class="text-brand">{c.blogCategories[post.data.category] ?? post.data.category}</span>
      </nav>

      <div class="mb-12 text-center max-w-3xl mx-auto" data-reveal>
        <MonoEyebrow color="brand" class="mb-3">{t('blog.articleEyebrow')}</MonoEyebrow>
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="mono-micro px-2.5 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">
            {c.blogCategories[post.data.category] ?? post.data.category}
          </span>
        </div>
        <h1 class="display-sm sm:display-md text-on-primary leading-tight break-words mb-4 page-enter rise-in">
          {loc.title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:gap-4 caption text-ash">
          <span>{t('common.byAuthor')} {post.data.author}</span>
          <span aria-hidden="true" class="hidden xxs:inline">•</span>
          <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true" class="hidden xxs:inline">•</span>
              <span>Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </>
          )}
          <span aria-hidden="true" class="hidden xxs:inline">•</span>
          <span>{post.data.readTime} {t('common.minRead')}</span>
        </div>
        <p class="subtitle text-ash leading-relaxed mt-4">{loc.description}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="mono-micro px-2.5 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">#{tag}</span>
          ))}
        </div>
      </div>

      <Image
        src={post.data.coverImage}
        alt={`${loc.title} — cover illustration`}
        width={1200}
        height={630}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="mt-8 rounded-marketing border border-hairline-soft w-full max-h-[420px] object-cover shadow-soft-drop"
        data-reveal
        data-reveal-delay="100"
      />

      <div class="mt-12 grid lg:grid-cols-[260px_1fr] gap-10" data-reveal data-reveal-delay="150">
        <aside class="hidden lg:block">
          <FeatureCard variant="dark" class="sticky top-24">
            <p class="mono-caps text-ash mb-3">{t('blog.post.toc')}</p>
            <ul class="mt-3 space-y-2.5 caption text-ash">
              {toc.map((h) => (
                <li style={`margin-left: ${(h.depth - 2) * 12}px`}>
                  <a href={`#${h.slug}`} class="text-ash hover:text-on-primary transition-colors line-clamp-2">{h.text}</a>
                </li>
              ))}
            </ul>
            <Button
              type="button"
              variant="secondary-dark"
              class="mt-6 w-full !h-9 text-xs"
              data-copy-link
            >
              {t('blog.post.share')} · {t('common.copyLink')}
            </Button>
          </FeatureCard>
        </aside>

        <div
          class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-sans prose-headings:text-on-primary prose-headings:font-normal prose-a:text-link-blue-soft hover:prose-a:underline prose-code:text-brand prose-pre:rounded-marketing prose-pre:border prose-pre:border-hairline-soft prose-pre:bg-canvas min-w-0"
          data-article-body
          data-copy-label={t('blog.post.copyCode')}
          data-copied-label={t('blog.post.copiedCode')}
        >
          <Content />
        </div>
      </div>

      {relatedTools.length > 0 && (
        <section class="mt-20 pt-12 border-t border-hairline-soft" aria-label="Related tools" data-reveal>
          <h2 class="heading-md text-on-primary mb-6 break-words">Related Tool{relatedTools.length > 1 ? 's' : ''}</h2>
          <div class="grid grid-cols-1 xs:grid-cols-2 gap-6">
            {relatedTools.map((app) => (
              <FeatureCard variant="dark" class="flex flex-col justify-between hover:border-graphite transition-colors lift-on-hover">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="mono-micro px-2 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">
                      {app.displayCategory}
                    </span>
                    <Icon name={app.icon} class="w-5 h-5 text-brand shrink-0 ml-2" />
                  </div>
                  <h3 class="heading-sm text-on-primary mb-2 break-words">{app.title}</h3>
                  <p class="body-sm text-ash leading-relaxed mb-4">{app.tagline}</p>
                </div>
                <div class="pt-4 border-t border-hairline-soft flex items-center justify-between flex-wrap gap-2">
                  {app.comingSoon || !app.landingUrl ? (
                    <span class="caption text-mute" aria-disabled="true">Coming Soon</span>
                  ) : (
                    <Button
                      href={app.landingUrl.startsWith('http') ? app.landingUrl : getLocalizedPath(app.landingUrl, lang)}
                      variant="secondary-dark"
                      target={app.landingUrl.startsWith('http') ? '_blank' : '_self'}
                      rel={app.landingUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="!h-8 !px-3 text-xs"
                    >
                      <span>Try it free</span>
                      <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 ml-1.5" />
                    </Button>
                  )}
                </div>
              </FeatureCard>
            ))}
          </div>
        </section>
      )}

      <section class="mt-20 pt-12 border-t border-hairline-soft" aria-label={t('blog.post.related')} data-reveal>
        <h2 class="heading-md text-on-primary mb-6 break-words">{t('blog.post.related')}</h2>
        <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedLoc.map(({ r, cleanSlug: rSlug, loc }) => (
            <div class="flex">
              <FeatureCard variant="dark" class="flex flex-col justify-between w-full hover:border-graphite transition-colors lift-on-hover !p-0 overflow-hidden">
                <Image
                  src={r.data.coverImage}
                  alt={`${loc.title} — related article cover`}
                  width={600}
                  height={216}
                  loading="lazy"
                  decoding="async"
                  class="h-40 w-full object-cover border-b border-hairline-soft"
                />
                <div class="p-6 flex flex-col justify-between flex-1">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <span class="mono-micro px-2 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">
                        {c.blogCategories[r.data.category] ?? r.data.category}
                      </span>
                      <span class="caption text-ash">{r.data.readTime} {t('common.minRead')}</span>
                    </div>
                    <h3 class="heading-sm text-on-primary mb-2 break-words">
                      <a href={`/blog/${rSlug}`} class="hover:text-brand transition-colors">
                        {loc.title}
                      </a>
                    </h3>
                  </div>
                  <div class="mt-6 pt-4 border-t border-hairline-soft flex items-center justify-between">
                    <span class="caption text-ash">{r.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                    <Button
                      href={`/blog/${rSlug}`}
                      variant="secondary-dark"
                      class="!h-8 !px-3 text-xs group"
                    >
                      <span>Read</span>
                      <Icon name="lucide:arrow-right" class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" />
                    </Button>
                  </div>
                </div>
              </FeatureCard>
            </div>
          ))}
        </div>

        <div class="mt-10">
          <Button
            href={getLocalizedPath('/blog', lang)}
            variant="secondary-dark"
            class="!h-9 !px-4 text-xs inline-flex items-center gap-2"
          >
            <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
            <span>{t('blog.post.backToBlog')}</span>
          </Button>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<script is:inline>
  // View-Transition safe: re-runs after every `astro:page-load` so code
  // copy buttons exist after client-side navigations. Guards prevent
  // duplicate buttons/listeners on double invocation.
  function setupArticleEnhancements() {
    var wrap = document.querySelector('[data-article-body]');
    if (!wrap) return;
    var copyLabel = (wrap && wrap.getAttribute('data-copy-label')) || 'Copy';
    var copiedLabel = (wrap && wrap.getAttribute('data-copied-label')) || 'Copied!';
    // Copy buttons on code blocks
    document.querySelectorAll('[data-article-body] pre').forEach(function (pre) {
      if (pre.querySelector('[data-copy-code]')) return;
      pre.style.position = 'relative';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-copy-code', '');
      btn.textContent = copyLabel;
      btn.className = 'btn-secondary-dark !h-7 !px-2.5 mono-micro !rounded-full absolute top-2 right-2 cursor-pointer z-10';
      btn.addEventListener('click', function () {
        var code = pre.querySelector('code');
        var text = code ? code.innerText : pre.innerText;
        function done() { btn.textContent = copiedLabel; setTimeout(function () { btn.textContent = copyLabel; }, 2000); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
      pre.appendChild(btn);
    });
    // Copy article link
    document.querySelectorAll('[data-copy-link]').forEach(function (btn) {
      if (btn.hasAttribute('data-wired')) return;
      btn.setAttribute('data-wired', 'true');
      var idleLabel = btn.textContent;
      btn.addEventListener('click', function () {
        var url = window.location.href;
        function done() {
          btn.textContent = copiedLabel;
          setTimeout(function () { btn.textContent = idleLabel; }, 2000);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(done);
        } else { done(); }
      });
    });
  }

  setupArticleEnhancements();
  document.addEventListener('astro:page-load', setupArticleEnhancements);
</script>
