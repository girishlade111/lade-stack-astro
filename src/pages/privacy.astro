---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent } from '../i18n/content';

const lang = 'en' as const;
const c = getContent(lang);
const updated = '2026-09-09';
const sections = c.privacy;
---
<BaseLayout
  lang={lang}
  path="/privacy"
  title="Privacy Policy - Lade Stack"
  description="Read our Privacy Policy to understand how we collect, use, and protect your personal information at Lade Stack."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-5xl font-bold">Privacy Policy</h1>
    <p class="mt-3 text-sm text-foreground/55">Last updated: {updated}</p>
    <div class="mt-8 space-y-8">
      {sections.map((s) => (
        <section>
          <h2 class="font-serif text-xl md:text-2xl font-bold">{s.h}</h2>
          <p class="mt-2 text-foreground/70 leading-relaxed">{s.p}</p>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
