---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContent } from '@/i18n/content';
import { useTranslations } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import Button from '@/components/ui/Button.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Icon from '@/components/Icon.astro';

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const c = getContent(defaultLang);

const faqs = c.contactFaqs;

const contactStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Lade Stack',
  url: 'https://ladestack.in/contact',
  description: 'Get in touch with Lade Stack for AI development support.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Lade Stack',
    address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', addressCountry: 'IN' },
    contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'admin@ladestack.in', availableLanguage: 'English' }
  }
};
---

<BaseLayout
  title="Contact Lade Stack — 24/7 Developer Support"
  description="Get in touch with Lade Stack for AI development assistance, platform inquiries, or technical support."
  keywords="contact Lade Stack, developer support, AI help, Mumbai"
  lang={defaultLang}
  path="/contact"
  structuredData={contactStructuredData}
>
  <!-- Hero Section: marketing-section-dark -->
  <section class="marketing-section-dark !pb-16 text-center">
    <div class="max-w-[1640px] mx-auto px-6">
      <MonoEyebrow color="brand" class="mb-3">
        {t('contact.badge') ?? 'GET IN TOUCH'}
      </MonoEyebrow>
      <h1 class="display-md text-on-primary mb-4">
        Let's Build Together
      </h1>
      <p class="subtitle text-ash max-w-xl mx-auto">
        Reach out directly to the core engineering team. We are available around the clock.
      </p>
    </div>
  </section>

  <!-- Form & Details: marketing-section-light [POLARITY FLIP] -->
  <section class="marketing-section-light">
    <div class="max-w-[1640px] mx-auto px-6">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 mb-20">
        <!-- Contact Info Cards in feature-card-light -->
        <div class="space-y-6">
          <FeatureCard variant="light">
            <div class="w-10 h-10 rounded-app-md bg-canvas text-on-primary flex items-center justify-center mb-4">
              <Icon name="lucide:mail" class="w-5 h-5" />
            </div>
            <h3 class="heading-sm text-ink mb-1">{t('contact.infoEmail')}</h3>
            <p class="caption text-ink/70 mb-3">{t('contact.infoEmailSub')}</p>
            <a href="mailto:admin@ladestack.in" class="body-sm font-semibold text-link-blue hover:underline">
              admin@ladestack.in
            </a>
          </FeatureCard>

          <FeatureCard variant="light">
            <div class="w-10 h-10 rounded-app-md bg-canvas text-on-primary flex items-center justify-center mb-4">
              <Icon name="lucide:map-pin" class="w-5 h-5" />
            </div>
            <h3 class="heading-sm text-ink mb-1">{t('contact.infoLocation')}</h3>
            <p class="caption text-ink/70 mb-3">{t('contact.infoLocationSub')}</p>
            <p class="body-sm font-semibold text-ink">Mumbai, India</p>
          </FeatureCard>
        </div>

        <!-- Contact Form with exact text-input and btn-primary-on-light -->
        <FeatureCard variant="light">
          <h2 class="heading-sm text-ink mb-6">{t('contact.sendTitle')}</h2>
          <form id="contact-form" class="space-y-4">
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-name">Your Name</label>
              <input type="text" id="c-name" required autocomplete="name" class="text-input w-full" />
            </div>
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-email">Email Address</label>
              <input type="email" id="c-email" required autocomplete="email" class="text-input w-full" />
            </div>
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-msg">Message</label>
              <textarea id="c-msg" rows="4" required class="text-input w-full !h-auto py-2.5"></textarea>
            </div>
            <button
              type="submit"
              id="c-submit-btn"
              data-sending={t('common.loading')}
              class="btn-primary-on-light w-full"
            >
              Send Message
            </button>
          </form>
          <!-- Exact alert-banner component from DESIGN.md -->
          <div id="c-success-msg" class="hidden mt-4 alert-banner text-center">
            Thank you! Your message has been received. We will respond shortly.
          </div>
        </FeatureCard>
      </div>

      <!-- FAQ Accordion -->
      <div class="max-w-3xl mx-auto">
        <h2 class="heading-md text-ink text-center mb-8">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group p-4 rounded-app-lg border border-hairline bg-canvas-light transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer font-medium text-ink text-sm list-none">
                <span>{faq.q}</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-mute group-open:rotate-180 transition-transform" />
              </summary>
              <p class="body-sm text-ink/75 leading-relaxed pt-3 mt-3 border-t border-hairline">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  function setupContactForm() {
    var form = /** @type {HTMLFormElement | null} */ (document.getElementById('contact-form'));
    var success = document.getElementById('c-success-msg');
    var btn = /** @type {HTMLButtonElement | null} */ (document.getElementById('c-submit-btn'));
    if (!form || !success || !btn) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      btn.innerText = btn.getAttribute('data-sending') || 'Sending...';
      btn.disabled = true;
      window.setTimeout(function () {
        form.reset();
        form.style.display = 'none';
        success.classList.remove('hidden');
      }, 1000);
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
