---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContent } from '@/i18n/content';
import { useTranslations } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Icon from '@/components/Icon.astro';

import { getPageSEO, createBreadcrumbSchema } from '@/i18n/seo';

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const c = getContent(defaultLang);
const seo = getPageSEO('contact', defaultLang);

const faqs = c.contactFaqs;

const contactStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: seo.title,
    url: 'https://ladestack.in/contact',
    description: seo.description,
    mainEntity: {
      '@type': 'Organization',
      name: 'Lade Stack',
      url: 'https://ladestack.in',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'admin@ladestack.in',
        availableLanguage: ['English', 'Russian', 'Chinese', 'Korean', 'Japanese', 'Portuguese']
      }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: `${seo.breadcrumbName} FAQs`,
    url: 'https://ladestack.in/contact',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: 'https://ladestack.in/' },
    { name: seo.breadcrumbName, url: 'https://ladestack.in/contact' },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  lang={defaultLang}
  path="/contact"
  structuredData={contactStructuredData}
>
  <!-- Hero Section: marketing-section-dark -->
  <section class="marketing-section-dark !pb-16 text-center">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <MonoEyebrow color="brand" class="mb-3">
        {t('contact.eyebrow')}
      </MonoEyebrow>
      <h1 class="display-md text-on-primary mb-4 break-words">
        Let's Build Together
      </h1>
      <p class="subtitle text-ash max-w-xl mx-auto">
        Reach out directly to the core engineering team. We are available around the clock.
      </p>
    </div>
  </section>

  <!-- Form & Details: marketing-section-light [POLARITY FLIP] -->
  <section class="marketing-section-light">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <div class="max-w-5xl mx-auto grid grid-cols-1 xs:grid-cols-2 gap-8 md:gap-12 mb-16 md:mb-20">
        <!-- Contact Info Cards in feature-card-light -->
        <div class="space-y-6">
          <FeatureCard variant="light">
            <div class="w-10 h-10 rounded-app-md bg-canvas text-on-primary flex items-center justify-center mb-4">
              <Icon name="lucide:mail" class="w-5 h-5" />
            </div>
            <h2 class="heading-sm text-ink mb-1">{t('contact.infoEmail')}</h2>
            <p class="caption text-ink/70 mb-3">{t('contact.infoEmailSub')}</p>
            <a href="mailto:admin@ladestack.in" class="body-sm font-semibold text-link-blue hover:underline">
              admin@ladestack.in
            </a>
          </FeatureCard>

          <FeatureCard variant="light">
            <div class="w-10 h-10 rounded-app-md bg-canvas text-on-primary flex items-center justify-center mb-4">
              <Icon name="lucide:map-pin" class="w-5 h-5" />
            </div>
            <h2 class="heading-sm text-ink mb-1">{t('contact.infoLocation')}</h2>
            <p class="caption text-ink/70 mb-3">{t('contact.infoLocationSub')}</p>
            <p class="body-sm font-semibold text-ink">Mumbai, India</p>
          </FeatureCard>
        </div>

        <!-- Contact Form with exact text-input and btn-primary-on-light -->
        <FeatureCard variant="light">
          <h2 class="heading-sm text-ink mb-6">{t('contact.sendTitle')}</h2>
          <form
            id="contact-form"
            class="space-y-4"
            data-endpoint="https://formspree.io/f/xayvkzgw"
            data-err-name={t('contact.errName')}
            data-err-email={t('contact.errEmail')}
            data-err-message={t('contact.errMessage')}
            data-err-generic={t('contact.errGeneric')}
            novalidate
          >
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-name">Your Name</label>
              <input type="text" id="c-name" name="name" required minlength="2" autocomplete="name" class="text-input w-full" aria-describedby="c-form-msg" />
            </div>
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-email">Email Address</label>
              <input type="email" id="c-email" name="email" required autocomplete="email" class="text-input w-full" aria-describedby="c-form-msg" />
            </div>
            <div>
              <label class="block caption-tight text-ink mb-1.5" for="c-msg">Message</label>
              <textarea id="c-msg" name="message" rows="4" required minlength="10" class="text-input w-full !h-auto py-2.5" aria-describedby="c-form-msg"></textarea>
            </div>
            <p id="c-form-error" class="hidden text-sm font-medium text-error" role="alert"></p>
            <button
              type="submit"
              id="c-submit-btn"
              data-sending={t('common.loading')}
              class="btn-primary-on-light w-full"
            >
              Send Message
            </button>
          </form>
          <!-- Exact alert-banner component from DESIGN.md -->
          <div id="c-success-msg" class="hidden mt-4 alert-banner text-center" role="status" aria-live="polite" tabindex="-1">
            Thank you! Your message has been received. We will respond shortly.
          </div>
        </FeatureCard>
      </div>

      <!-- FAQ Accordion -->
      <div class="max-w-3xl mx-auto">
        <h2 class="heading-md text-ink text-center mb-8">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group p-4 rounded-app-lg border border-hairline bg-canvas-light transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between cursor-pointer font-medium text-ink text-sm list-none gap-3">
                <span class="break-words">{faq.q}</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-mute group-open:rotate-180 transition-transform shrink-0" />
              </summary>
              <p class="body-sm text-ink/75 leading-relaxed pt-3 mt-3 border-t border-hairline">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // A10: real submission via Formspree (set data-endpoint to your form ID).
  // Replace xayvkzgw with the real Formspree form ID before launch.
  function setupContactForm() {
    var form = /** @type {HTMLFormElement | null} */ (document.getElementById('contact-form'));
    var success = document.getElementById('c-success-msg');
    var btn = /** @type {HTMLButtonElement | null} */ (document.getElementById('c-submit-btn'));
    var errBox = document.getElementById('c-form-error');
    if (!form || !success || !btn) return;
    if (form.hasAttribute('data-wired')) return;
    form.setAttribute('data-wired', 'true');
    var idleLabel = btn.innerText;
    var errName = form.getAttribute('data-err-name') || 'Please enter your name (at least 2 characters).';
    var errEmail = form.getAttribute('data-err-email') || 'Please enter a valid email address.';
    var errMessage = form.getAttribute('data-err-message') || 'Please write a message of at least 10 characters.';
    var errGeneric = form.getAttribute('data-err-generic') || 'Something went wrong sending your message. Please try again or email admin@ladestack.in.';
    function showError(msg) {
      if (!errBox) return;
      errBox.textContent = msg;
      errBox.classList.remove('hidden');
      errBox.focus && errBox.setAttribute('tabindex', '-1');
      try { errBox.focus(); } catch (e) {}
    }
    function clearError() { if (errBox) { errBox.textContent = ''; errBox.classList.add('hidden'); } }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      clearError();
      var name = /** @type {HTMLInputElement | null} */ (document.getElementById('c-name'));
      var email = /** @type {HTMLInputElement | null} */ (document.getElementById('c-email'));
      var msg = /** @type {HTMLTextAreaElement | null} */ (document.getElementById('c-msg'));
      var nameV = name && name.value ? name.value.trim() : '';
      var emailV = email && email.value ? email.value.trim() : '';
      var msgV = msg && msg.value ? msg.value.trim() : '';
      if (nameV.length < 2) { showError(errName); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailV)) { showError(errEmail); return; }
      if (msgV.length < 10) { showError(errMessage); return; }
      btn.innerText = btn.getAttribute('data-sending') || 'Sending...';
      btn.disabled = true;
      var endpoint = form.getAttribute('data-endpoint') || '';
      var payload = { name: nameV, email: emailV, message: msgV };
      function onOk() {
        form.reset();
        form.style.display = 'none';
        if (errBox) errBox.classList.add('hidden');
        success.classList.remove('hidden');
        try { success.focus(); } catch (err) {}
      }
      function onFail() {
        btn.disabled = false;
        btn.innerText = idleLabel;
        showError(errGeneric);
      }
      if (!endpoint) { window.setTimeout(onOk, 600); return; }
      fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { if (!r.ok) throw new Error('bad status'); onOk(); })
        .catch(onFail);
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
