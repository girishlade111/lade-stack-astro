---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContent } from '@/i18n/content';
import { useTranslations } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Icon from '@/components/Icon.astro';

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const c = getContent(defaultLang);

const aboutStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Lade Stack',
  url: 'https://ladestack.in/about',
  founder: {
    '@type': 'Person',
    name: 'Girish Lade',
    jobTitle: 'Founder & Lead Developer',
    url: 'https://github.com/girishlade111',
  },
};

const stack = ['TypeScript', 'Astro', 'Python', 'AI Systems', 'Tailwind CSS', 'PostgreSQL'];
---

<BaseLayout
  title="About Lade Stack — Vision, Founder & Mission"
  description="How Girish Lade founded Lade Stack to give every creator free, enterprise-grade AI developer tools — story, stack, and journey."
  keywords="Girish Lade, Lade Stack founder, AI developer tools, engineering vision"
  lang={defaultLang}
  path="/about"
  structuredData={aboutStructuredData}
>
  <div class="marketing-section-dark">
    <div class="max-w-4xl mx-auto px-6">
      <!-- Header -->
      <div class="text-center mb-16">
        <MonoEyebrow color="brand" class="mb-3">OUR STORY</MonoEyebrow>
        <h1 class="display-md text-on-primary mb-4">
          Empowering Developers Through AI
        </h1>
        <p class="subtitle text-ash max-w-2xl mx-auto leading-relaxed">
          Lade Stack began with a singular mission: build enterprise-grade software tools that are 100% free and open for every engineer on earth.
        </p>
      </div>

      <!-- Founder Section using feature-card-dark (#212121, 32px padding, 12px radius, 1px border) -->
      <FeatureCard variant="dark" class="mb-16">
        <div class="flex flex-col sm:flex-row items-center gap-8">
          <div class="w-44 sm:w-52 aspect-[2/3] shrink-0 rounded-2xl border border-hairline-soft bg-canvas p-1.5 shadow-lg overflow-hidden flex items-center justify-center">
            <img
              src="/images/profile.png"
              alt="Girish Lade - Founder & Lead Developer"
              width="1024"
              height="1536"
              class="w-full h-full object-contain rounded-xl"
              loading="eager"
              decoding="async"
            />
          </div>
          <div>
            <h2 class="heading-md text-on-primary">Girish Lade</h2>
            <p class="mono-eyebrow text-brand mt-0.5">{t('about.role')}</p>
            <p class="body text-ash mt-4 leading-relaxed">
              "We believe that the barriers to building transformative software should be zero. By engineering autonomous testing, documentation AI, and instant compilation into free cloud tools, we help developers build 10x faster."
            </p>
            <div class="flex items-center gap-3 mt-6">
              <a
                href="https://github.com/girishlade111"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-app-sm border border-hairline-soft hover:bg-canvas text-ash hover:text-on-primary transition-colors"
                aria-label="GitHub"
              >
                <Icon name="lucide:github" class="w-4 h-4" />
              </a>
              <a
                href="https://www.linkedin.com/in/girish-lade-075bba201/"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 rounded-app-sm border border-hairline-soft hover:bg-canvas text-ash hover:text-on-primary transition-colors"
                aria-label="LinkedIn"
              >
                <Icon name="lucide:linkedin" class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </FeatureCard>

      <!-- Tech stack badges -->
      <div class="text-center mb-16">
        <h2 class="mono-caps text-mute mb-4">{t('about.stack')}</h2>
        <div class="flex flex-wrap justify-center gap-2">
          {stack.map((s) => (
            <span class="btn-app-tab !h-8 !px-3">{s}</span>
          ))}
        </div>
      </div>

      <!-- Journey timeline -->
      <div>
        <h2 class="heading-md text-on-primary text-center mb-8">Journey</h2>
        <ol class="relative border-l border-hairline-soft ml-4 space-y-8 max-w-2xl mx-auto">
          {c.timeline.map((item) => (
            <li class="ml-6">
              <span class="absolute -left-[5px] mt-1 h-2.5 w-2.5 rounded-full bg-brand" aria-hidden="true"></span>
              <p class="mono-eyebrow text-brand">{item.year}</p>
              <h3 class="heading-sm text-on-primary mt-0.5">{item.title}</h3>
              <p class="body-sm text-ash mt-1 leading-relaxed">{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</BaseLayout>
