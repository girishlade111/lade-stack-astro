---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const stats = [
  { value: '2020', label: 'Founded' },
  { value: '9+', label: 'Production tools' },
  { value: '8K+', label: 'Developers' },
  { value: '100%', label: 'Free forever' }
];
const timeline = [
  { year: '2020', title: 'The toolkit begins', text: 'Girish Lade starts building personal developer utilities — PDF, image, and code helpers.' },
  { year: '2022', title: 'Lade Stack takes shape', text: 'Tools consolidate under one brand with a shared design language and free-forever pledge.' },
  { year: '2024', title: 'AI-powered ecosystem', text: 'CodeEnhance AI launches; blog and docs grow to 27+ guides; community passes 8,000 developers.' },
  { year: '2026', title: 'Pure Astro re-creation', text: 'Full static rebuild: zero-JS runtime, 6 languages, 100/100 Lighthouse.' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Lade Stack',
  url: 'https://ladestack.in',
  logo: 'https://ladestack.in/favicon.ico',
  foundingDate: '2020',
  description: 'AI-powered development tools ecosystem founded by Girish Lade.',
  founder: { '@type': 'Person', name: 'Girish Lade', jobTitle: 'Founder & Lead Developer', url: 'https://ladestack.in/about' },
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'admin@ladestack.in' },
  sameAs: ['https://github.com/girishlade111', 'https://www.linkedin.com/in/girish-lade-075bba201/', 'https://www.instagram.com/girish_lade_/', 'https://codepen.io/Girish-Lade-the-looper']
};
---
<BaseLayout
  lang={lang}
  path="/about"
  title="About Lade Stack - Empowering Developers Through AI Innovation & Visionary Leadership"
  description="Discover Lade Stack's inspiring journey from a developer's vision to an AI-powered development ecosystem. Founded by Girish Lade, we democratize advanced development tools for creators worldwide."
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    <p class="text-xs font-mono uppercase tracking-widest text-sage-500">About</p>
    <h1 class="font-serif text-4xl md:text-6xl font-bold mt-3">{t('about.title')}</h1>
    <p class="mt-4 text-foreground/65 max-w-2xl md:text-lg">{t('about.subtitle')}</p>

    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      {stats.map((s) => (
        <div class="rounded-2xl border border-border bg-card/60 p-6 text-center">
          <p class="font-serif text-3xl font-bold text-sage-500">{s.value}</p>
          <p class="mt-1 text-sm text-foreground/60">{s.label}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 grid md:grid-cols-2 gap-8 items-start">
      <div>
        <h2 class="font-serif text-2xl md:text-4xl font-bold">{t('about.storyTitle')}</h2>
        <p class="mt-4 text-foreground/70 leading-relaxed">{t('about.storyBody')}</p>
        <p class="mt-4 text-foreground/70 leading-relaxed">Multi-disciplinary engineer and designer with expertise in AI systems, web development, and user experience — building tools that give every creator startup-velocity superpowers at zero cost.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {['TypeScript', 'Astro', 'Python', 'AI Systems', 'Tailwind CSS', 'PostgreSQL'].map((s) => (
            <span class="text-xs font-mono px-3 py-1.5 rounded-full bg-sage-500/10 text-sage-600 dark:text-sage-400 border border-sage-500/20">{s}</span>
          ))}
        </div>
      </div>
      <ol class="relative border-l border-border ml-2 space-y-8">
        {timeline.map((item) => (
          <li class="ml-6">
            <span class="absolute -left-[7px] mt-1 h-3.5 w-3.5 rounded-full bg-sage-500 border-2 border-background" aria-hidden="true"></span>
            <p class="font-mono text-sm text-sage-500">{item.year}</p>
            <h3 class="font-semibold text-lg mt-0.5">{item.title}</h3>
            <p class="text-sm text-foreground/65 mt-1">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-14 rounded-3xl bg-sage-500 text-white p-8 md:p-12 text-center">
      <h2 class="font-serif text-2xl md:text-4xl font-bold">{t('about.ctaTitle')}</h2>
      <div class="mt-6 flex flex-col sm:flex-row justify-center gap-3">
        <a href={getLocalizedPath('/contact', lang)} class="inline-flex h-12 px-7 items-center justify-center rounded-full bg-white text-sage-700 font-semibold">{t('about.ctaPrimary')}</a>
        <a href={getLocalizedPath('/apps', lang)} class="inline-flex h-12 px-7 items-center justify-center rounded-full border border-white/40 font-semibold hover:bg-white/10">{t('about.ctaSecondary')}</a>
      </div>
    </div>
  </div>
</BaseLayout>
