---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  path="/404"
  title="404 - Page Not Found - Lade Stack"
  description="The page you are looking for does not exist."
  noIndex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-24 md:py-32 text-center">
    <p class="font-mono text-7xl md:text-8xl font-bold text-sage-500">404</p>
    <h1 class="font-serif text-3xl md:text-4xl font-bold mt-4">{t('notFound.title')}</h1>
    <p class="mt-3 text-foreground/60">{t('notFound.description')}</p>
    <a href={getLocalizedPath('/', lang)} class="mt-8 inline-flex h-12 px-8 items-center justify-center rounded-full bg-sage-500 text-white font-semibold hover:bg-sage-600">{t('notFound.backHome')}</a>
  </div>
</BaseLayout>
