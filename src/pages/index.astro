---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import ValuesSection from '@/components/sections/ValuesSection.astro';
import ImpactSection from '@/components/sections/ImpactSection.astro';
import ProductsSection from '@/components/sections/ProductsSection.astro';
import FreeForeverSection from '@/components/sections/FreeForeverSection.astro';
import CommunitySection from '@/components/sections/CommunitySection.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import { getContent } from '@/i18n/content';
import { getPageSEO } from '@/i18n/seo';

const defaultLang = 'en' as const;
const c = getContent(defaultLang);
const seo = getPageSEO('home', defaultLang);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://ladestack.in/#webapp',
  applicationCategory: 'DeveloperApplication',
  name: 'Lade Stack',
  url: 'https://ladestack.in',
  description: seo.description,
  operatingSystem: 'Web Browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@id': 'https://ladestack.in/#organization' },
  mainEntityOfPage: { '@id': 'https://ladestack.in/#website' },
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  lang={defaultLang}
  path="/"
  structuredData={structuredData}
>
  <HeroSection lang={defaultLang} />
  <AboutSection lang={defaultLang} />
  <ValuesSection lang={defaultLang} />
  <ImpactSection lang={defaultLang} />
  <ProductsSection lang={defaultLang} />
  <FreeForeverSection lang={defaultLang} />
  <CommunitySection lang={defaultLang} />
  <Testimonials lang={defaultLang} />
</BaseLayout>
