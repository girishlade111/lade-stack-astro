---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { getPageSEO, createBreadcrumbSchema } from '../i18n/seo';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

const lang = 'en' as const;
const t = useTranslations(lang);
const c = getContent(lang);
const seo = getPageSEO('support', lang);

const topics = c.supportTopics;
const faqs = c.supportFaqs;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: seo.title,
    url: 'https://ladestack.in/support',
    description: seo.description,
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
  },
  createBreadcrumbSchema([
    { name: t('nav.home'), url: 'https://ladestack.in/' },
    { name: seo.breadcrumbName, url: 'https://ladestack.in/support' },
  ]),
];
---
<BaseLayout
  lang={lang}
  path="/support"
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  structuredData={structuredData}
>
  <section class="marketing-section-dark">
    <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <MonoEyebrow color="brand" class="mb-3">{t('support.eyebrow')}</MonoEyebrow>
        <h1 class="display-md text-on-primary mb-4 break-words">{t('support.heading')}</h1>
        <p class="subtitle text-ash max-w-2xl mx-auto">{t('support.subtitle')}</p>
      </div>

      <!-- Topics -->
      <div class="grid grid-cols-1 xxs:grid-cols-2 lg:grid-cols-4 gap-4 mb-16 md:mb-20">
        {topics.map((topic, topicIdx) => (
          <div
            class="flex"
            data-reveal
            data-reveal-delay={String((topicIdx % 4) * 80)}
          >
            <FeatureCard variant="dark" class="w-full hover:border-graphite transition-colors lift-on-hover">
              <h2 class="heading-sm text-on-primary break-words">{topic.title}</h2>
              <p class="mt-2 body-sm text-ash leading-relaxed break-words">{topic.text}</p>
            </FeatureCard>
          </div>
        ))}
      </div>

      <!-- FAQ Accordion (contact.astro pattern) -->
      <div class="max-w-3xl mx-auto mb-16 md:mb-20">
        <h2 class="heading-md text-on-primary text-center mb-8" data-reveal>{t('support.faqTitle')}</h2>
        <div class="space-y-4">
          {faqs.map((f, faqIdx) => (
            <details
              data-reveal
              data-reveal-delay={String((faqIdx % 4) * 60)}
              class="group p-4 rounded-app-lg border border-hairline bg-canvas-light transition-all [&_summary::-webkit-details-marker]:hidden"
            >
              <summary class="flex items-center justify-between cursor-pointer font-medium text-ink text-sm list-none gap-3">
                <span class="break-words">{f.q}</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-mute group-open:rotate-180 transition-transform shrink-0" />
              </summary>
              <p class="body-sm text-ink/75 leading-relaxed pt-3 mt-3 border-t border-hairline">
                {f.a}
              </p>
            </details>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="max-w-3xl mx-auto" data-reveal>
        <FeatureCard variant="dark" class="text-center hover:border-graphite transition-colors lift-on-hover">
          <h2 class="heading-md text-on-primary mb-4 break-words">{t('support.stillStuck')}</h2>
          <p class="body text-ash max-w-xl mx-auto mb-6">{t('support.respondNote')}</p>
          <Button href={getLocalizedPath('/contact', lang)} variant="primary">
            {t('support.contactCta')}
          </Button>
        </FeatureCard>
      </div>
    </div>
  </section>
</BaseLayout>
