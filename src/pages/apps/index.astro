---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLocalizedApps, getContent } from '@/i18n/content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

const defaultLang = 'en' as const;
const t = useTranslations(defaultLang);
const c = getContent(defaultLang);
const apps = getLocalizedApps(defaultLang);
const categories = [...new Set(apps.map((a) => a.category))];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Apps Gallery – Lade Stack',
  url: 'https://ladestack.in/apps',
  description: 'A curated gallery of AI-powered developer tools built by Lade Stack.'
};
---

<BaseLayout
  title="Apps Gallery — AI Developer Tools Suite | Lade Stack"
  description="Explore Lade Stack's suite of AI-powered developer tools: code editor, API testing, website builder, file sharing, and documentation AI."
  keywords="AI apps, developer tools, CodeEnhance AI, PDF tools, image tools"
  lang={defaultLang}
  path="/apps"
  structuredData={structuredData}
>
  <div class="marketing-section-dark">
    <div class="max-w-[1640px] mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <MonoEyebrow color="brand" class="mb-3">GALLERY</MonoEyebrow>
        <h1 class="display-md text-on-primary mb-4">
          Apps Gallery
        </h1>
        <p class="subtitle text-ash mb-8">
          Discover specialized AI-powered utilities engineered for speed, privacy, and productivity.
        </p>

        <!-- Category Filter Pills using btn-app-tab tokens -->
        <div class="flex flex-wrap items-center justify-center gap-2" id="apps-filter-pills">
          <button
            type="button"
            class="app-pill btn-app-tab !h-8 !px-3 active cursor-pointer"
            data-category="All"
          >
            All
          </button>
          {
            categories.map((cat) => (
              <button
                type="button"
                class="app-pill btn-app-tab !h-8 !px-3 cursor-pointer"
                data-category={cat}
              >
                {c.appCategories[cat] ?? cat}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Apps Grid using feature-card-dark (#212121, 32px padding, 12px radius, 1px border) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="apps-grid">
        {
          apps.map((app) => (
            <div data-category={app.category} class="app-card flex">
              <FeatureCard variant="dark" class="flex flex-col justify-between w-full hover:border-graphite transition-colors">
                <div>
                  <div class="flex items-center justify-between mb-6">
                    <span class="mono-micro px-2 py-1 rounded-full bg-canvas border border-hairline-soft text-ash">
                      {app.displayCategory}
                    </span>
                    <Icon name={app.icon} class="w-6 h-6 text-brand" />
                  </div>
                  <h2 class="heading-sm text-on-primary mb-2">
                    {app.title}
                  </h2>
                  <p class="caption text-brand/90 mb-3">{app.tagline} · {c.appTime[app.timeToValue] ?? app.timeToValue}</p>
                  <p class="body-sm text-ash leading-relaxed">{app.description}</p>

                  <!-- Feature Bullets -->
                  <ul class="mt-6 space-y-2 caption text-ash">
                    {app.features.map((f: string) => (
                      <li class="flex items-center gap-2">
                        <Icon name="lucide:check" class="w-3.5 h-3.5 text-success" />
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-hairline-soft flex items-center justify-between">
                  <span class="mono-micro text-success">
                    {app.comingSoon ? 'Coming soon' : 'Free Forever'}
                  </span>
                  {app.comingSoon || !app.landingUrl ? (
                    <span class="caption text-mute" aria-disabled="true">{t('apps.inProgress')} · Coming soon</span>
                  ) : (
                    <Button
                      href={app.landingUrl.startsWith('http') ? app.landingUrl : getLocalizedPath(app.landingUrl, defaultLang)}
                      variant="secondary-dark"
                      target={app.landingUrl.startsWith('http') ? '_blank' : '_self'}
                      rel={app.landingUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      <span>Launch App</span>
                      <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 ml-1.5" />
                    </Button>
                  )}
                </div>
              </FeatureCard>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupAppsFilter(): void {
    const pills = document.querySelectorAll<HTMLButtonElement>('.app-pill');
    const cards = document.querySelectorAll<HTMLElement>('.app-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const cat = pill.getAttribute('data-category') || 'All';
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          card.style.display = cat === 'All' || cardCat === cat ? 'flex' : 'none';
        });
      });
    });
  }

  setupAppsFilter();
  document.addEventListener('astro:page-load', setupAppsFilter);
</script>
