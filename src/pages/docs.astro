---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import { getContent } from '../i18n/content';

const lang = 'en' as const;
const t = useTranslations(lang);
const c = getContent(lang);

const categories = c.docsGroups;
const changelog = c.docsChangelog;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  name: 'Lade Stack Documentation',
  url: 'https://ladestack.in/docs',
  description: 'Comprehensive documentation for Lade Stack developer tools.',
  publisher: { '@type': 'Organization', name: 'Lade Stack' }
};
---
<BaseLayout
  lang={lang}
  path="/docs"
  title="Documentation – Guides & API Reference | Lade Stack"
  description="Comprehensive documentation for Lade Stack's developer tools. Step-by-step guides, API references, and tutorials to get started quickly."
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    <h1 class="font-serif text-4xl md:text-6xl font-bold break-words">Docs</h1>
    <p class="mt-3 text-foreground/65 max-w-2xl md:text-lg">{t('docs.subtitle')}</p>
    <input type="search" data-docs-search placeholder={t('docs.searchPlaceholder')} aria-label={t('docs.searchPlaceholder')} class="mt-8 h-11 px-4 rounded-full border border-border bg-card text-sm outline-none focus:border-primary w-full md:max-w-sm" />

    <!-- Mobile / Tablet Quick Jump Bar -->
    <nav aria-label="Documentation sections mobile" class="lg:hidden flex items-center gap-2 overflow-x-auto pb-2 mt-6 scrollbar-none">
      {categories.map((c) => (
        <a href={`#${c.id}`} class="shrink-0 px-3 py-1.5 rounded-full border border-border bg-card/60 text-xs font-medium text-foreground/80 hover:bg-muted hover:text-foreground transition-colors">
          {c.title}
        </a>
      ))}
      <a href="#changelog" class="shrink-0 px-3 py-1.5 rounded-full border border-border bg-card/60 text-xs font-medium text-foreground/80 hover:bg-muted hover:text-foreground transition-colors">
        {t('docs.changelog')}
      </a>
    </nav>

    <div class="mt-8 grid lg:grid-cols-[240px_1fr] gap-8 items-start">
      <nav aria-label="Documentation sections" class="hidden lg:block sticky top-24 rounded-2xl border border-border bg-card/60 p-4">
        <ul class="space-y-1 text-sm">
          {categories.map((c) => (
            <li><a href={`#${c.id}`} class="block px-3 py-2 rounded-lg text-foreground/70 hover:bg-muted hover:text-foreground">{c.title}</a></li>
          ))}
          <li><a href="#changelog" class="block px-3 py-2 rounded-lg text-foreground/70 hover:bg-muted hover:text-foreground">{t('docs.changelog')}</a></li>
        </ul>
      </nav>

      <div class="space-y-10 min-w-0">
        {categories.map((c) => (
          <section id={c.id} data-docs-section scroll-mt-24>
            <h2 class="font-serif text-2xl font-bold break-words">{c.title}</h2>
            <div class="mt-4 space-y-3">
              {c.articles.map((a) => (
                <details data-docs-article={` ${a.title} ${a.text}`.toLowerCase()} class="group rounded-2xl border border-border bg-card/60 px-5 py-4 open:border-primary/40">
                  <summary class="cursor-pointer font-medium list-none flex items-center justify-between gap-3">
                    <span class="break-words">{a.title}</span>
                    <span aria-hidden="true" class="text-primary transition-transform group-open:rotate-45 text-xl leading-none shrink-0">+</span>
                  </summary>
                  <p class="mt-3 text-sm text-foreground/65 leading-relaxed break-words">{a.text}</p>
                </details>
              ))}
            </div>
          </section>
        ))}

        <section id="changelog" scroll-mt-24>
          <h2 class="font-serif text-2xl font-bold">{t('docs.changelog')}</h2>
          <ol class="mt-4 space-y-3">
            {changelog.map((c) => (
              <li class="rounded-2xl border border-border bg-card/60 px-5 py-4">
                <p class="flex items-center gap-3 text-sm"><span class="font-mono font-semibold text-primary">{c.v}</span><span class="text-foreground/55">{c.date}</span></p>
                <p class="mt-1 text-sm text-foreground/70">{c.text}</p>
              </li>
            ))}
          </ol>
        </section>
        <p data-docs-empty class="hidden text-foreground/60">{t('common.noResults')}</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // View-Transition safe: re-wires after every `astro:page-load`.
  function setupDocsSearch() {
    var input = document.querySelector('[data-docs-search]');
    if (!input || input.hasAttribute('data-wired')) return;
    input.setAttribute('data-wired', 'true');
    var articles = Array.prototype.slice.call(document.querySelectorAll('[data-docs-article]'));
    var empty = document.querySelector('[data-docs-empty]');
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var visible = 0;
      articles.forEach(function (a) {
        var text = a.getAttribute('data-docs-article') || '';
        var show = !q || text.indexOf(q) !== -1;
        a.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      document.querySelectorAll('[data-docs-section]').forEach(function (sec) {
        var anyVisible = Array.prototype.some.call(sec.querySelectorAll('[data-docs-article]'), function (a) {
          return !a.classList.contains('hidden');
        });
        sec.classList.toggle('hidden', !anyVisible);
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    });
  }

  setupDocsSearch();
  document.addEventListener('astro:page-load', setupDocsSearch);
</script>
