---
// Footer.astro — Global footer, newsletter (vanilla JS), socials (Step 05)
import type { SupportedLocale } from '../i18n/config';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const platformLinks = [
  { label: 'AI Code Viewer', href: '/ai-code-viewer-ai' },
  { label: 'Apps Gallery', href: '/apps' },
  { label: 'Blog', href: '/blog' },
  { label: 'Documentation', href: '/docs' }
];
const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Support', href: '/support' }
];
const resourceLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Support Center', href: '/support' }
];
const socials = [
  { label: 'GitHub', href: 'https://github.com/girishlade111' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/girish-lade-075bba201/' },
  { label: 'Instagram', href: 'https://www.instagram.com/girish_lade_/' },
  { label: 'CodePen', href: 'https://codepen.io/Girish-Lade-the-looper' }
];
const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-card/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-sage-500 text-white font-serif font-bold text-lg">L</span>
          <span class="font-serif font-bold text-lg">Lade Stack</span>
        </a>
        <p class="mt-4 text-sm text-foreground/70 max-w-sm">{t('footer.tagline')}</p>
        <form data-newsletter class="mt-5 flex max-w-sm gap-2" novalidate>
          <label class="sr-only" for="newsletter-email">{t('footer.newsletterTitle')}</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder={t('common.emailPlaceholder')}
            class="flex-1 h-10 px-3.5 rounded-full border border-border bg-background text-sm outline-none focus:border-sage-500"
          />
          <button type="submit" class="h-10 px-4 rounded-full bg-sage-500 text-white text-sm font-semibold hover:bg-sage-600 transition-colors">
            {t('common.subscribe')}
          </button>
        </form>
        <p data-newsletter-msg class="hidden mt-2 text-sm text-sage-600 dark:text-sage-400" role="status"></p>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-xs font-semibold text-foreground/70 hover:text-foreground hover:bg-muted transition-colors"
            >
              {s.label.slice(0, 2)}
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      <nav aria-label={t('footer.platform')}>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-foreground/60">{t('footer.platform')}</h3>
        <ul class="mt-4 space-y-2.5">
          {platformLinks.map((l) => (
            <li><a href={getLocalizedPath(l.href, lang)} class="text-sm text-foreground/75 hover:text-foreground transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t('footer.company')}>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-foreground/60">{t('footer.company')}</h3>
        <ul class="mt-4 space-y-2.5">
          {companyLinks.map((l) => (
            <li><a href={getLocalizedPath(l.href, lang)} class="text-sm text-foreground/75 hover:text-foreground transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label={t('footer.resources')}>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-foreground/60">{t('footer.resources')}</h3>
        <ul class="mt-4 space-y-2.5">
          {resourceLinks.map((l) => (
            <li><a href={getLocalizedPath(l.href, lang)} class="text-sm text-foreground/75 hover:text-foreground transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-foreground/60">© {year} Lade Stack. {t('footer.rights')}</p>
      <p class="text-xs text-foreground/60">{t('footer.madeWith')}</p>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-newsletter]').forEach(function (form) {
      var formEl = /** @type {HTMLFormElement} */ (form);
      formEl.addEventListener('submit', function (e) {
        e.preventDefault();
        var input = /** @type {HTMLInputElement | null} */ (formEl.querySelector('input[type="email"]'));
        var msg = /** @type {HTMLElement | null} */ (
          formEl.parentElement ? formEl.parentElement.querySelector('[data-newsletter-msg]') : null
        );
        var email = input && input.value ? input.value.trim() : '';
        var valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!valid) {
          if (input) {
            input.setAttribute('aria-invalid', 'true');
            input.style.borderColor = '#ef4444';
          }
          return;
        }
        if (input) {
          input.value = '';
          input.removeAttribute('aria-invalid');
          input.style.borderColor = '';
        }
        if (msg) {
          msg.textContent = 'Thanks for subscribing! Check your inbox soon.';
          msg.classList.remove('hidden');
          setTimeout(function () { if (msg) msg.classList.add('hidden'); }, 5000);
        }
      });
    });
  })();
</script>
