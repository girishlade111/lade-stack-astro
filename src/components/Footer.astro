---
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import type { SupportedLocale } from '@/i18n/config';
import { getContent } from '@/i18n/content';
import BrandMark from '@/components/ui/BrandMark.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = getContent(lang);
const currentYear = new Date().getFullYear();
---

<!-- DESIGN.md footer: canvas bg (#0b0b0b), 64px py, 24px px, mono-caps eyebrows, caption links -->
<footer transition:name="site-footer" class="bg-canvas text-on-primary py-12 sm:py-16 px-4 sm:px-6 border-t border-hairline-soft/40">
  <div class="max-w-[1640px] mx-auto">
    <div class="grid grid-cols-1 xs:grid-cols-2 md:grid-cols-4 gap-8 pb-12 sm:pb-16">
      <!-- Brand column -->
      <div class="space-y-4">
        <a href={getLocalizedPath('/', lang)} class="inline-block" aria-label="Lade Stack home">
          <BrandMark />
        </a>
        <p class="body text-ash text-sm max-w-sm leading-relaxed">
          {t('footer.tagline')}
        </p>
        <div class="flex items-center gap-2 text-ash pt-2">
          <a
            href="https://github.com/girishlade111"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-app-sm hover:text-on-primary hover:bg-canvas-soft transition-colors"
            aria-label="GitHub"
          >
            <Icon name="lucide:github" class="w-4 h-4" />
          </a>
          <a
            href="https://www.linkedin.com/in/girish-lade-075bba201/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-app-sm hover:text-on-primary hover:bg-canvas-soft transition-colors"
            aria-label="LinkedIn"
          >
            <Icon name="lucide:linkedin" class="w-4 h-4" />
          </a>
          <a
            href="https://www.instagram.com/girish_lade_/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-app-sm hover:text-on-primary hover:bg-canvas-soft transition-colors"
            aria-label="Instagram"
          >
            <Icon name="lucide:instagram" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Quick Links (Platform) -->
      <nav aria-label={t('footer.platform')}>
        <!-- footer-eyebrow: mono-caps (11px, IBM Plex Mono, text-mute) -->
        <h3 class="mono-caps text-mute mb-4 tracking-wider">{t('footer.platform')}</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={getLocalizedPath('/apps', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {t('nav.apps')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/ai-code-viewer-ai', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {c.footerLinks.aiCodeViewer}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/docs', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {t('nav.docs')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/blog', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {t('nav.blog')}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Company & Support -->
      <nav aria-label={t('footer.company')}>
        <h3 class="mono-caps text-mute mb-4 tracking-wider">{t('footer.company')}</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={getLocalizedPath('/about', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/contact', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {t('nav.contact')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/support', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {c.footerLinks.support}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/privacy', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {c.footerLinks.privacy}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/terms', lang)} class="caption text-ash hover:text-on-primary transition-colors">
              {c.footerLinks.terms}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Newsletter Box with text-input-dark and btn-primary -->
      <div>
        <h3 class="mono-caps text-mute mb-4 tracking-wider">{t('footer.newsletterTitle')}</h3>
        <p class="caption text-ash mb-3 leading-relaxed">
          {t('footer.newsletterDesc')}
        </p>
        <form data-newsletter data-success={t('footer.subscribed')} class="space-y-2.5" novalidate>
          <label class="sr-only" for="newsletter-email">{t('footer.newsletterTitle')}</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder={t('common.emailPlaceholder')}
            aria-describedby="newsletter-msg"
            class="text-input-dark w-full"
          />
          <button
            type="submit"
            class="btn-primary w-full !h-10 text-sm"
          >
            {t('common.subscribe')}
          </button>
        </form>
        <p data-newsletter-msg id="newsletter-msg" class="hidden mt-2 text-xs" role="status" aria-live="polite"></p>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="border-t border-hairline-soft pt-8 flex flex-col sm:flex-row items-center justify-between meta text-ash gap-4 text-center sm:text-left">
      <div class="flex items-center justify-center sm:justify-start gap-2 flex-wrap">
        <span class="w-2.5 h-2.5 rounded-full bg-brand shrink-0"></span>
        <p>© {currentYear} Lade Stack. Built by Girish Lade. {t('common.copyright')}</p>
      </div>
      <p class="mono-micro text-mute">{t('footer.stack')}</p>
    </div>
  </div>
</footer>

<script is:inline>
  // View-Transition safe: re-wires fresh newsletter forms after every
  // `astro:page-load`. Guarded per-form so initial + page-load double
  // invocation on first load never double-submits.
  function setupNewsletter() {
    document.querySelectorAll('[data-newsletter]').forEach(function (form) {
      if (form.hasAttribute('data-wired')) return;
      form.setAttribute('data-wired', 'true');
      var formEl = /** @type {HTMLFormElement} */ (form);
      formEl.addEventListener('submit', function (e) {
        e.preventDefault();
        var input = /** @type {HTMLInputElement | null} */ (formEl.querySelector('input[type="email"]'));
        var msg = /** @type {HTMLElement | null} */ (
          formEl.parentElement ? formEl.parentElement.querySelector('[data-newsletter-msg]') : null
        );
        if (!msg) {
          var next = formEl.nextElementSibling;
          if (next && next.hasAttribute('data-newsletter-msg')) msg = /** @type {HTMLElement} */ (next);
        }
        var email = input && input.value ? input.value.trim() : '';
        var valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        function showMsg(text, ok) {
          if (!msg) return;
          msg.textContent = text;
          msg.classList.remove('hidden');
          msg.style.color = ok ? '#37cd84' : '#dd0000';
          if (input) input.setAttribute('aria-describedby', 'newsletter-msg');
        }
        if (!valid) {
          if (input) {
            input.setAttribute('aria-invalid', 'true');
            input.style.borderColor = '#dd0000';
          }
          showMsg('Please enter a valid email address (e.g. you@example.com).', false);
          return;
        }
        if (input) {
          input.value = '';
          input.removeAttribute('aria-invalid');
          input.style.borderColor = '';
        }
        showMsg(formEl.getAttribute('data-success') || '', true);
        // B11: keep success visible until the user interacts again (no pure 5s timeout).
        if (msg) {
          var hideTimer = window.setTimeout(function () { if (msg) msg.classList.add('hidden'); }, 15000);
          var cancelHide = function () { window.clearTimeout(hideTimer); };
          formEl.addEventListener('input', cancelHide, { once: true });
        }
      });
    });
  }

  setupNewsletter();
  document.addEventListener('astro:page-load', setupNewsletter);
</script>
