---
interface Props {
  title?: string;
  tabs?: string[];
  activeTab?: string;
  class?: string;
  lang?: string;
}

const {
  title = 'LadeStack Studio — ai-code-viewer.ts',
  tabs = ['ai-code-viewer.ts', 'api-testing.json', 'preview.html'],
  activeTab = 'ai-code-viewer.ts',
  class: className = '',
  lang = 'en',
} = Astro.props;

const currentLang = lang || Astro.currentLocale || 'en';

// Determine if caller passed custom slot content (like ErrorView.astro)
const isDefaultStudioWindow = tabs.some(
  (t) =>
    t.toLowerCase() === 'ai-code-viewer.ts' ||
    t.toLowerCase() === 'api-testing.json' ||
    t.toLowerCase() === 'preview.html'
);
const hasCustomSlot = Astro.slots.has('default') && !isDefaultStudioWindow;

// Tab 1: AI-CODE-VIEWER.TS (CodeEnhance AI / Zero Runtime SSG Engine)
const tab1Lines = [
  `<span class="text-mute">// @ladestack/engine — Autonomous Edge SSG &amp; Code Intelligence</span>`,
  `<span class="text-brand">import</span> <span class="text-ash">&#123;</span> <span class="text-link-blue-soft">createPlatform</span> <span class="text-ash">&#125;</span> <span class="text-brand">from</span> <span class="text-success">'@ladestack/core'</span><span class="text-ash">;</span>`,
  `<span class="text-brand">import</span> <span class="text-ash">&#123;</span> <span class="text-link-blue-soft">codeEnhanceAI</span> <span class="text-ash">&#125;</span> <span class="text-brand">from</span> <span class="text-success">'@ladestack/ai-tools'</span><span class="text-ash">;</span>`,
  `<span>&nbsp;</span>`,
  `<span class="text-brand">const</span> platform = <span class="text-brand">await</span> <span class="text-link-blue-soft">createPlatform</span><span class="text-ash">(&#123;</span>`,
  `<span class="inline-block pl-4">locale: <span class="text-success">'${currentLang}'</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-4">zeroRuntime: <span class="text-brand">true</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-4">copilot: <span class="text-link-blue-soft">codeEnhanceAI</span><span class="text-ash">(&#123;</span> mode: <span class="text-success">'strict'</span> <span class="text-ash">&#125;)</span></span>`,
  `<span class="text-ash">&#125;);</span>`,
  `<span>&nbsp;</span>`,
  `<span class="text-success font-bold mr-1.5 select-none">&#62;</span><span class="text-success font-semibold">BUILD COMPLETE</span><span class="text-ash">:</span> 27 articles, 9 tools, 0kb client js runtime`,
  `<span class="text-mute mr-1.5 select-none">&#62;</span>Ready at <span class="text-link-blue-soft underline underline-offset-2">https://ladestack.in</span> <span class="text-mute">(0ms TTFB)</span>`,
];

// Tab 2: API-TESTING.JSON (API Testing Platform)
const tab2Lines = [
  `<span class="text-ash">&#123;</span>`,
  `<span class="inline-block pl-4"><span class="text-link-blue-soft">"suite"</span><span class="text-ash">:</span> <span class="text-success">"ladestack-edge-cluster"</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-4"><span class="text-link-blue-soft">"environment"</span><span class="text-ash">:</span> <span class="text-success">"production-edge-bom1"</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-4"><span class="text-link-blue-soft">"request"</span><span class="text-ash">: &#123;</span></span>`,
  `<span class="inline-block pl-8"><span class="text-link-blue-soft">"method"</span><span class="text-ash">:</span> <span class="text-brand">"POST"</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-8"><span class="text-link-blue-soft">"endpoint"</span><span class="text-ash">:</span> <span class="text-success">"/v1/ai/code-enhance"</span><span class="text-ash">,</span></span>`,
  `<span class="inline-block pl-8"><span class="text-link-blue-soft">"headers"</span><span class="text-ash">: &#123;</span> <span class="text-link-blue-soft">"Authorization"</span><span class="text-ash">:</span> <span class="text-success">"Bearer ls_sec_live_9f82"</span> <span class="text-ash">&#125;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">&#125;,</span></span>`,
  `<span class="inline-block pl-4"><span class="text-link-blue-soft">"assertions"</span><span class="text-ash">: [</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&#123;</span> <span class="text-link-blue-soft">"status"</span><span class="text-ash">:</span> <span class="text-brand">200</span><span class="text-ash">,</span> <span class="text-link-blue-soft">"responseTimeMs"</span><span class="text-ash">:</span> <span class="text-brand">42</span> <span class="text-ash">&#125;,</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&#123;</span> <span class="text-link-blue-soft">"schema"</span><span class="text-ash">:</span> <span class="text-success">"ValidASTResponse"</span><span class="text-ash">,</span> <span class="text-link-blue-soft">"passed"</span><span class="text-ash">:</span> <span class="text-brand">true</span> <span class="text-ash">&#125;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">],</span></span>`,
  `<span class="inline-block pl-4"><span class="text-link-blue-soft">"result"</span><span class="text-ash">:</span> <span class="text-success">"&#62; 2/2 tests passed (42ms) • SSL Verified"</span></span>`,
  `<span class="text-ash">&#125;</span>`,
];

// Tab 3: PREVIEW.HTML (Website Builder AI / Live Preview)
const tab3Lines = [
  `<span class="text-mute">&lt;!-- Generated by Website Builder AI • Semantic Astro Target --&gt;</span>`,
  `<span><span class="text-ash">&lt;</span><span class="text-brand">section</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"hero-canvas"</span> <span class="text-link-blue-soft">data-engine</span><span class="text-ash">=</span><span class="text-success">"ladestack-ai"</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">&lt;</span><span class="text-brand">header</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"editorial-lockup"</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&lt;</span><span class="text-brand">span</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"mono-badge"</span><span class="text-ash">&gt;</span>SYSTEM READY<span class="text-ash">&lt;/</span><span class="text-brand">span</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&lt;</span><span class="text-brand">h1</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"display-mega"</span><span class="text-ash">&gt;</span>Engineered for Extreme Speed<span class="text-ash">&lt;/</span><span class="text-brand">h1</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&lt;</span><span class="text-brand">p</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"subtitle"</span><span class="text-ash">&gt;</span>Zero client-side JS runtime with 100% SSG.<span class="text-ash">&lt;/</span><span class="text-brand">p</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">&lt;/</span><span class="text-brand">header</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">&lt;</span><span class="text-brand">div</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"cta-actions"</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-8"><span class="text-ash">&lt;</span><span class="text-brand">a</span> <span class="text-link-blue-soft">href</span><span class="text-ash">=</span><span class="text-success">"/apps"</span> <span class="text-link-blue-soft">class</span><span class="text-ash">=</span><span class="text-success">"btn-primary"</span><span class="text-ash">&gt;</span>Explore Suite &amp;rarr;<span class="text-ash">&lt;/</span><span class="text-brand">a</span><span class="text-ash">&gt;</span></span>`,
  `<span class="inline-block pl-4"><span class="text-ash">&lt;/</span><span class="text-brand">div</span><span class="text-ash">&gt;</span></span>`,
  `<span><span class="text-ash">&lt;/</span><span class="text-brand">section</span><span class="text-ash">&gt;</span></span>`,
  `<span class="text-success font-bold mr-1.5 select-none">&#62;</span><span class="text-success font-semibold">COMPILED</span><span class="text-ash">:</span> output/dist/index.html <span class="text-mute">(3.4kb gzip, 100/100 LH)</span>`,
];

const panelsData: Record<string, string[]> = {
  'ai-code-viewer.ts': tab1Lines,
  'api-testing.json': tab2Lines,
  'preview.html': tab3Lines,
};

const baseTitlePrefix = title.includes(' — ') ? title.split(' — ')[0] : 'LadeStack Studio';
---

<div
  class={`studio-window relative w-full text-left overflow-hidden rounded-app-lg bg-canvas-soft border border-hairline-soft ${className}`}
  style="box-shadow: 0 0 35px -10px rgba(243, 100, 88, 0.12), 0 20px 40px -15px rgba(0, 0, 0, 0.6);"
  data-studio-window
  data-base-title={baseTitlePrefix}
>
  <!-- macOS-style Chrome Header -->
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-hairline-soft gap-2 overflow-hidden select-none">
    <!-- Three Traffic Light Dots and Title -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
      </div>
      <span class="mono-micro text-mute hidden md:inline truncate max-w-[280px]" data-window-title>
        {title}
      </span>
    </div>

    <!-- Interactive Tabs Header -->
    <div
      class="flex items-center gap-1.5 overflow-x-auto max-w-full py-0.5"
      role="tablist"
      aria-label="Studio Window Tabs"
    >
      {tabs.map((tab) => {
        const isCurrent = tab.toLowerCase() === activeTab.toLowerCase();
        return (
          <button
            type="button"
            role="tab"
            aria-selected={isCurrent ? 'true' : 'false'}
            aria-controls={`panel-${tab.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}
            data-studio-tab={tab}
            class={`studio-tab-btn select-none shrink-0 font-mono text-[11px] font-medium tracking-wide uppercase px-2.5 py-1 rounded-app-xs transition-all duration-150 cursor-pointer border ${
              isCurrent
                ? 'text-brand bg-brand/10 border-brand/25 font-semibold'
                : 'text-mute hover:text-ash hover:bg-canvas-soft/70 border-transparent'
            }`}
          >
            {tab.toUpperCase()}
          </button>
        );
      })}
    </div>

    <!-- Right Window Status Marker -->
    <div class="flex items-center gap-1.5 text-xs text-ash font-mono shrink-0">
      <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse" aria-hidden="true"></span>
      <span class="hidden sm:inline text-[10px] text-mute font-medium tracking-wider uppercase">ready</span>
    </div>
  </div>

  <!-- Studio Window Body Slot or Built-in Interactive Panels -->
  <div class="relative min-h-[340px] rounded-app-sm bg-[#161616] border border-hairline-soft/60 overflow-hidden text-ash font-mono text-xs leading-6">
    <!-- Subtle CRT scanline overlay (restrained, 3.5% opacity) -->
    <div
      class="pointer-events-none absolute inset-0 select-none opacity-[0.035] rounded-app-sm z-10"
      style="background: repeating-linear-gradient(to bottom, transparent 0px, transparent 2px, rgba(255, 255, 255, 0.3) 3px, rgba(255, 255, 255, 0.3) 4px);"
      aria-hidden="true"
    ></div>

    {hasCustomSlot ? (
      <div class="p-4 overflow-x-auto">
        <slot />
      </div>
    ) : (
      <div>
        {tabs.map((tab) => {
          const normalized = tab.toLowerCase();
          const panelLines = panelsData[normalized] || tab1Lines;
          const isCurrent = normalized === activeTab.toLowerCase();
          return (
            <div
              id={`panel-${normalized.replace(/[^a-z0-9]/g, '-')}`}
              role="tabpanel"
              data-studio-panel={tab}
              class={`py-3 px-3 sm:px-4 ${isCurrent ? 'block' : 'hidden'}`}
            >
              <div class="flex items-start font-mono text-xs leading-6">
                <!-- Line numbers gutter -->
                <div
                  class="select-none text-right pr-3 pl-1 text-mute/40 border-r border-hairline-soft/40 w-8 sm:w-9 shrink-0 space-y-0 font-mono text-xs leading-6"
                  aria-hidden="true"
                >
                  {panelLines.map((_, i) => (
                    <div>{String(i + 1).padStart(2, '0')}</div>
                  ))}
                </div>

                <!-- Code lines stream area -->
                <div class="pl-3 sm:pl-4 flex-1 overflow-x-auto min-w-0" data-code-lines>
                  {panelLines.map((lineHtml, i) => (
                    <div
                      class="studio-line whitespace-nowrap"
                      data-studio-line
                      data-line-num={i + 1}
                      set:html={lineHtml}
                    />
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</div>

<style>
  @keyframes studio-cursor-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  :global(.studio-cursor) {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 5px;
    vertical-align: -2px;
    background-color: #f36458;
    border-radius: 1px;
    animation: studio-cursor-blink 1s steps(1, start) infinite;
    box-shadow: 0 0 8px rgba(243, 100, 88, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.studio-cursor) {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script is:inline>
  function initStudioWindows() {
    document.querySelectorAll('[data-studio-window]').forEach(function (win) {
      if (win.getAttribute('data-studio-initialized') === '1') return;
      win.setAttribute('data-studio-initialized', '1');

      var tabButtons = win.querySelectorAll('[data-studio-tab]');
      var tabPanels = win.querySelectorAll('[data-studio-panel]');
      var titleEl = win.querySelector('[data-window-title]');
      var baseTitle = win.getAttribute('data-base-title') || 'LadeStack Studio';
      var streamTimer = null;
      var cursorEl = null;

      // Create persistent blinking terminal cursor
      cursorEl = document.createElement('span');
      cursorEl.className = 'studio-cursor';
      cursorEl.setAttribute('aria-hidden', 'true');

      function streamLines(panel, instant) {
        if (streamTimer) {
          clearTimeout(streamTimer);
          streamTimer = null;
        }
        if (cursorEl && cursorEl.parentNode) {
          cursorEl.parentNode.removeChild(cursorEl);
        }

        var lines = panel.querySelectorAll('[data-studio-line]');
        if (!lines.length) return;

        if (instant) {
          lines.forEach(function (l) {
            l.style.display = 'block';
          });
          var lastLine = lines[lines.length - 1];
          lastLine.appendChild(cursorEl);
          return;
        }

        // Hide all lines before staggered typing animation begins
        lines.forEach(function (l) {
          l.style.display = 'none';
        });

        var index = 0;
        function nextLine() {
          if (index < lines.length) {
            var currentLine = lines[index];
            currentLine.style.display = 'block';
            currentLine.appendChild(cursorEl);
            index++;
            streamTimer = setTimeout(nextLine, 65);
          } else {
            // Typing complete: cursor remains blinking idle on the terminal prompt
            streamTimer = null;
          }
        }

        nextLine();
      }

      function switchTab(targetTabName, instant) {
        var normalizedTarget = targetTabName.toLowerCase();

        // Update tab buttons state
        tabButtons.forEach(function (btn) {
          var btnTab = (btn.getAttribute('data-studio-tab') || '').toLowerCase();
          var isTarget = btnTab === normalizedTarget;
          btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          if (isTarget) {
            btn.classList.add('text-brand', 'bg-brand/10', 'border-brand/25', 'font-semibold');
            btn.classList.remove('text-mute', 'border-transparent');
          } else {
            btn.classList.remove('text-brand', 'bg-brand/10', 'border-brand/25', 'font-semibold');
            btn.classList.add('text-mute', 'border-transparent');
          }
        });

        // Update title bar text dynamically to match active file
        if (titleEl) {
          titleEl.textContent = baseTitle + ' — ' + normalizedTarget;
        }

        // Activate matching panel
        var activePanel = null;
        tabPanels.forEach(function (p) {
          var panelTab = (p.getAttribute('data-studio-panel') || '').toLowerCase();
          var isTarget = panelTab === normalizedTarget;
          if (isTarget) {
            p.classList.remove('hidden');
            p.style.display = 'block';
            activePanel = p;
          } else {
            p.classList.add('hidden');
            p.style.display = 'none';
          }
        });

        if (activePanel) {
          var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          streamLines(activePanel, instant || prefersReducedMotion);
        }
      }

      // Attach click events to tabs
      tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var targetTab = btn.getAttribute('data-studio-tab');
          if (btn.getAttribute('aria-selected') === 'true') return;
          switchTab(targetTab, false);
        });
      });

      // Initial stream for the active tab
      var initialTabBtn =
        win.querySelector('[data-studio-tab][aria-selected="true"]') || tabButtons[0];
      if (initialTabBtn) {
        var initialTab = initialTabBtn.getAttribute('data-studio-tab');
        var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        switchTab(initialTab, prefersReducedMotion);
      }
    });
  }

  // Idempotent initialization safe for initial page load and Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStudioWindows);
  } else {
    initStudioWindows();
  }
  document.addEventListener('astro:page-load', initStudioWindows);
</script>
