---
interface Props {
  class?: string;
  size?: 'default' | 'sm';
}

const { class: className = '', size = 'default' } = Astro.props;
---

<div class={`inline-flex items-center select-none ${className}`}>
  <!-- Brand Dot: exact 12px circle #f36458, 8px margin-right, scales to 10px on xxxs (DESIGN.md) -->
  <span
    class={`rounded-full bg-brand shrink-0 mr-2 transition-all ${
      size === 'sm' ? 'w-2.5 h-2.5' : 'w-3 h-3 xxxs:w-2.5 xxxs:h-2.5'
    }`}
    aria-hidden="true"
  ></span>
  <span class="font-sans font-medium text-lg tracking-tight text-inherit">
    Lade Stack
  </span>
</div>
