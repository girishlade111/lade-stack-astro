---
interface Props {
  class?: string;
  color?: 'mute' | 'brand' | 'ash' | 'inherit';
  id?: string;
}

const { class: className = '', color = 'mute', id } = Astro.props;

const colorClasses = {
  mute: 'text-mute',
  brand: 'text-brand',
  ash: 'text-ash',
  inherit: 'text-inherit',
};
---

<p class={`mono-eyebrow ${colorClasses[color]} ${className}`} id={id}>
  <slot />
</p>
