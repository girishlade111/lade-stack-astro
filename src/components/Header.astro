---
import { useTranslations, getLocalizedPath, getRouteFromUrl } from '@/i18n/utils';
import type { SupportedLocale } from '@/i18n/config';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import BrandMark from '@/components/ui/BrandMark.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  lang: SupportedLocale;
  /** Hide the locale switcher (error pages such as /404, /500). */
  hideLanguageSwitcher?: boolean;
}

const { lang, hideLanguageSwitcher = false } = Astro.props;
const t = useTranslations(lang);
const route = getRouteFromUrl(Astro.url);

const navLinks = [
  { key: 'nav.products' as const, path: '/products' },
  { key: 'nav.apps' as const, path: '/apps' },
  { key: 'nav.blog' as const, path: '/blog' },
  { key: 'nav.about' as const, path: '/about' },
  { key: 'nav.docs' as const, path: '/docs' },
  { key: 'nav.contact' as const, path: '/contact' },
];

function hrefFor(link: { path: string; canonicalOnly?: boolean }): string {
  if (link.canonicalOnly) return link.path;
  return getLocalizedPath(link.path, lang);
}

function isActive(path: string): boolean {
  if (path === '/') return route === '/';
  return route === path || route.startsWith(path + '/');
}
---

<!-- DESIGN.md nav-bar-dark: sticky, 64px height, 24px px, canvas bg, no border line -->
<header data-site-header transition:name="site-header" class="sticky top-0 z-50 w-full h-16 bg-canvas text-on-primary">
  <div class="max-w-[1640px] mx-auto px-4 sm:px-6 h-full flex items-center justify-between">
    <!-- Brand Logo with exact 12px brand-dot -->
    <a href={getLocalizedPath('/', lang)} class="flex items-center group shrink-0" aria-label="Lade Stack home">
      <BrandMark />
    </a>

    <!-- Centered Navigation Links (Desktop, collapses at <960px per DESIGN.md) -->
    <nav class="hidden sm:flex items-center gap-6" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={hrefFor(link)}
          aria-current={isActive(link.path) ? 'page' : undefined}
          class={`py-2 text-base font-medium transition-colors hover:text-ash ${
            isActive(link.path) ? 'text-on-primary font-semibold' : 'text-ash'
          }`}
        >
          {t(link.key)}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Right) -->
    <div class="flex items-center gap-2 sm:gap-3">
      {!hideLanguageSwitcher && (
        <div class="hidden sm:flex items-center gap-2">
          <LanguageSwitcher currentLang={lang} />
        </div>
      )}

      <!-- button-primary CTA (white pill on dark canvas) -->
      <Button href={getLocalizedPath('/apps', lang)} variant="primary" class="text-xs xxs:text-sm !h-9 xxs:!h-10 px-2.5 xxs:px-4 shrink-0">
        {t('nav.launchApp')}
      </Button>

      <!-- Mobile Hamburger Button (<960px sm breakpoint per DESIGN.md) -->
      <button
        type="button"
        id="mobile-menu-btn"
        data-mobile-open
        class="sm:hidden p-2 rounded-app-md border border-hairline-soft text-on-primary hover:bg-canvas-soft focus:outline-none shrink-0"
        aria-label="Toggle Mobile Menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <Icon name="lucide:menu" class="w-5 h-5" />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div data-mobile-backdrop class="hidden fixed inset-0 top-16 z-40 bg-canvas/80 backdrop-blur-sm sm:hidden"></div>
  <nav
    id="mobile-drawer"
    data-mobile-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Mobile"
    class="hidden sm:hidden fixed inset-x-0 top-16 bg-canvas border-b border-hairline-soft shadow-2xl z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto"
  >
    <div class="p-6 flex flex-col gap-3">
      {navLinks.map((link) => (
        <a
          href={hrefFor(link)}
          data-mobile-link
          aria-current={isActive(link.path) ? 'page' : undefined}
          class={`py-3 text-base font-medium border-b border-hairline-soft/50 transition-colors ${
            isActive(link.path) ? 'text-on-primary font-semibold' : 'text-ash hover:text-on-primary'
          }`}
        >
          {t(link.key)}
        </a>
      ))}
      {!hideLanguageSwitcher && (
        <div class="pt-3 flex items-center justify-between text-sm text-ash">
          <span>{t('common.language')}</span>
          <LanguageSwitcher currentLang={lang} />
        </div>
      )}
    </div>
  </nav>
</header>

<script is:inline>
  // View-Transition safe: re-wires the fresh header DOM after every
  // `astro:page-load`. Element listeners are per-node (fresh nodes each
  // navigation); document-level listeners are attached once via window flag.
  function setupMobileMenu() {
    var openBtn = document.querySelector('[data-mobile-open]');
    var drawer = document.querySelector('[data-mobile-drawer]');
    var backdrop = document.querySelector('[data-mobile-backdrop]');

    function setOpen(open) {
      var d = document.querySelector('[data-mobile-drawer]');
      var b = document.querySelector('[data-mobile-open]');
      var bd = document.querySelector('[data-mobile-backdrop]');
      if (!d || !b) return;
      d.classList.toggle('hidden', !open);
      if (bd) bd.classList.toggle('hidden', !open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
      // B9: focus trap — move focus in on open, return to toggle on close.
      if (open) {
        window.__ladestackDrawerOpener = b;
        var first = d.querySelector('a, button');
        if (first) { try { first.focus(); } catch (e) {} }
      } else if (window.__ladestackDrawerOpener) {
        try { window.__ladestackDrawerOpener.focus(); } catch (e) {}
        window.__ladestackDrawerOpener = null;
      }
    }

    function closeMenu() {
      setOpen(false);
    }

    if (openBtn && !openBtn.hasAttribute('data-wired')) {
      openBtn.setAttribute('data-wired', 'true');
      openBtn.addEventListener('click', function () {
        var d = document.querySelector('[data-mobile-drawer]');
        setOpen(d ? d.classList.contains('hidden') : false);
      });
    }
    if (backdrop && !backdrop.hasAttribute('data-wired')) {
      backdrop.setAttribute('data-wired', 'true');
      backdrop.addEventListener('click', closeMenu);
    }
    if (drawer && !drawer.hasAttribute('data-wired')) {
      drawer.setAttribute('data-wired', 'true');
      drawer.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });
    }

    if (!window.__ladestackHeaderDocWired) {
      window.__ladestackHeaderDocWired = true;
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
        // B9: keep Tab cycling inside the open drawer.
        if (e.key === 'Tab') {
          var d = document.querySelector('[data-mobile-drawer]');
          if (!d || d.classList.contains('hidden')) return;
          var items = d.querySelectorAll('a, button');
          if (!items.length) return;
          var first = items[0];
          var last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      });
      // Always start navigations with the drawer closed.
      document.addEventListener('astro:before-preparation', closeMenu);
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
