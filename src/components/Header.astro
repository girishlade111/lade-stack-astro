---
// Header.astro — Sticky nav, language dropdown, theme toggle, mobile drawer (Step 05)
import type { SupportedLocale } from '../i18n/config';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: SupportedLocale;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
  { key: 'nav.home' as const, path: '/' },
  { key: 'nav.about' as const, path: '/about' },
  { key: 'nav.apps' as const, path: '/apps' },
  { key: 'nav.blog' as const, path: '/blog' },
  { key: 'nav.contact' as const, path: '/contact' }
];

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path + '/');
}
---
<header
  data-site-header
  class="sticky top-0 z-40 w-full border-b border-transparent transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-3">
      <!-- Brand -->
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5 shrink-0" aria-label="Lade Stack home">
        <span class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-sage-500 text-white font-serif font-bold text-lg">
          L
          <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
        </span>
        <span class="font-serif font-bold text-lg tracking-tight">Lade Stack</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
        {navLinks.map((link) => (
          <a
            href={getLocalizedPath(link.path, lang)}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class={`px-3.5 py-2 rounded-full text-sm font-medium transition-colors ${isActive(link.path) ? 'bg-sage-500/15 text-foreground' : 'text-foreground/70 hover:text-foreground hover:bg-muted'}`}
          >
            {t(link.key)}
          </a>
        ))}
      </nav>

      <!-- Actions -->
      <div class="hidden md:flex items-center gap-2">
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <ThemeToggle />
        <a
          href={getLocalizedPath('/apps', lang)}
          class="inline-flex items-center h-9 px-4 rounded-full bg-sage-500 text-white text-sm font-semibold hover:bg-sage-600 transition-colors"
        >
          {t('nav.getStarted')}
        </a>
      </div>

      <!-- Mobile hamburger -->
      <div class="flex md:hidden items-center gap-2">
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <ThemeToggle />
        <button
          type="button"
          data-mobile-open
          aria-label={t('nav.menu')}
          aria-expanded="false"
          aria-controls="mobile-drawer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card"
        >
          <svg data-icon-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
          <svg data-icon-close class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div data-mobile-backdrop class="hidden fixed inset-0 top-16 z-30 bg-black/40 backdrop-blur-sm md:hidden"></div>
  <nav
    id="mobile-drawer"
    data-mobile-drawer
    aria-label="Mobile"
    class="hidden md:hidden fixed inset-x-0 top-16 z-40 border-b border-border bg-background/95 backdrop-blur-xl"
  >
    <div class="px-4 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(link.path, lang)}
          class={`px-4 py-3 rounded-xl text-base font-medium transition-colors ${isActive(link.path) ? 'bg-sage-500/15' : 'hover:bg-muted'}`}
        >
          {t(link.key)}
        </a>
      ))}
      <a
        href={getLocalizedPath('/apps', lang)}
        class="mt-2 inline-flex items-center justify-center h-11 px-4 rounded-xl bg-sage-500 text-white font-semibold"
      >
        {t('nav.getStarted')}
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-site-header]');
    var openBtn = document.querySelector('[data-mobile-open]');
    var drawer = document.querySelector('[data-mobile-drawer]');
    var backdrop = document.querySelector('[data-mobile-backdrop]');
    var iconOpen = document.querySelector('[data-icon-open]');
    var iconClose = document.querySelector('[data-icon-close]');

    function setOpen(open) {
      if (!drawer || !backdrop || !openBtn) return;
      drawer.classList.toggle('hidden', !open);
      backdrop.classList.toggle('hidden', !open);
      openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    if (openBtn) {
      openBtn.addEventListener('click', function () {
        var isHidden = drawer && drawer.classList.contains('hidden');
        setOpen(!!isHidden);
      });
    }
    if (backdrop) backdrop.addEventListener('click', function () { setOpen(false); });
    if (drawer) {
      drawer.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setOpen(false); });
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });

    // Scroll-aware blur + border
    function onScroll() {
      if (!header) return;
      var scrolled = window.scrollY > 8;
      header.classList.toggle('bg-background/80', scrolled);
      header.classList.toggle('backdrop-blur-xl', scrolled);
      header.classList.toggle('border-border', scrolled);
      header.classList.toggle('border-transparent', !scrolled);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
