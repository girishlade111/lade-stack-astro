---
// LanguageSwitcher.astro — Accessible Vanilla JS locale dropdown (Step 05)
// Preserves current sub-route across locales, persists to localStorage.
import { languages, type SupportedLocale } from '../i18n/config';
import { getRouteFromUrl, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;

// Resolve route: prefer explicit currentPath, else derive at runtime via data attr
const locales = Object.entries(languages) as [SupportedLocale, (typeof languages)[SupportedLocale]][];
const current = languages[lang];
---
<div class="relative" data-lang-switcher>
  <button
    type="button"
    data-lang-button
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Select language"
    class="inline-flex items-center gap-1.5 h-9 px-3 rounded-full border border-border bg-card text-sm text-foreground hover:bg-muted transition-colors"
  >
    <span aria-hidden="true">{current.flag}</span>
    <span class="hidden sm:inline font-medium">{current.nativeName}</span>
    <span class="sm:hidden font-medium uppercase">{lang}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <ul
    data-lang-menu
    role="listbox"
    aria-label="Languages"
    class="hidden absolute right-0 mt-2 w-52 rounded-xl border border-border bg-popover p-1.5 shadow-xl z-50"
  >
    {locales.map(([code, meta]) => {
      const href = getLocalizedPath(currentPath, code);
      const active = code === lang;
      return (
        <li role="option" aria-selected={active ? 'true' : 'false'}>
          <a
            href={href}
            data-lang-link={code}
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-colors ${active ? 'bg-sage-500/15 text-foreground font-semibold' : 'text-foreground/80 hover:bg-muted'}`}
          >
            <span aria-hidden="true" class="text-base">{meta.flag}</span>
            <span class="flex-1">{meta.nativeName}</span>
            {active && <span aria-hidden="true" class="text-sage-500">✓</span>}
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script is:inline>
  (function () {
    function currentRoute() {
      var path = window.location.pathname || '/';
      var locales = ['en', 'zh', 'ko', 'ja', 'tr', 'pt-BR'];
      for (var i = 0; i < locales.length; i++) {
        var l = locales[i];
        if (l === 'en') continue;
        if (path === '/' + l) return '/';
        if (path.indexOf('/' + l + '/') === 0) return path.slice(l.length + 1) || '/';
      }
      return path || '/';
    }
    function localizedPath(route, lang) {
      if (lang === 'en') return route === '/' ? '/' : route;
      return route === '/' ? '/' + lang : '/' + lang + route;
    }
    document.querySelectorAll('[data-lang-switcher]').forEach(function (root) {
      var btn = root.querySelector('[data-lang-button]');
      var menu = root.querySelector('[data-lang-menu]');
      if (!btn || !menu) return;
      function close() {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
      function open() {
        // Rewrite hrefs to preserve current sub-route at click-time
        var route = currentRoute();
        root.querySelectorAll('[data-lang-link]').forEach(function (a) {
          var code = a.getAttribute('data-lang-link');
          if (code) a.setAttribute('href', localizedPath(route, code));
        });
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (menu.classList.contains('hidden')) open();
        else close();
      });
      document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });
      root.querySelectorAll('[data-lang-link]').forEach(function (a) {
        a.addEventListener('click', function () {
          try {
            localStorage.setItem('ladestack-lang', a.getAttribute('data-lang-link') || 'en');
          } catch (err) {}
        });
      });
    });
  })();
</script>
