---
import type { SupportedLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import { getContent } from '@/i18n/content';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const testimonials = getContent(lang).testimonials;
---

<!-- Section 8: marketing-section-light (#ffffff) per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-light" data-reveal>
  <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <MonoEyebrow color="mute" class="mb-3">
        {t('home.testimonials.eyebrow')}
      </MonoEyebrow>
      <h2 class="display-md text-ink mb-4">
        {t('home.testimonials.title')}
      </h2>
      <p class="subtitle text-ink/70">
        {t('home.testimonials.subtitle')}
      </p>
    </div>

    <!-- Testimonial cards using feature-card-light on canvas-light -->
    <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((item) => (
        <FeatureCard variant="light" class="flex flex-col justify-between">
          <div>
            <div class="text-ink text-sm tracking-widest mb-4" aria-label="5 stars rating">★★★★★</div>
            <blockquote class="body text-ink/80 leading-relaxed italic mb-6">
              “{item.quote}”
            </blockquote>
          </div>
          <div class="pt-4 border-t border-hairline">
            <p class="caption-tight text-ink font-semibold">{item.name}</p>
            <p class="meta text-mute">{item.role}</p>
          </div>
        </FeatureCard>
      ))}
    </div>
  </div>
</section>
