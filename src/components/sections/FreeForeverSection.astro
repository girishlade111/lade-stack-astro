---
import type { SupportedLocale } from '../../i18n/config';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props { lang: SupportedLocale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-sage-500 text-white px-8 py-12 md:p-16 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <div class="absolute -top-20 -left-20 h-64 w-64 rounded-full bg-white blur-3xl"></div>
        <div class="absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-white blur-3xl"></div>
      </div>
      <p class="font-mono text-5xl md:text-6xl font-bold relative">$0</p>
      <h2 class="font-serif text-3xl md:text-5xl font-bold mt-3 relative">{t('home.free.title')}</h2>
      <p class="mt-4 text-white/85 max-w-xl mx-auto relative">{t('home.free.description')}</p>
      <a href={getLocalizedPath('/apps', lang)} class="relative mt-8 inline-flex items-center justify-center h-12 px-8 rounded-full bg-white text-sage-700 font-semibold hover:bg-warm transition-colors">
        {t('home.free.cta')}
      </a>
    </div>
  </div>
</section>
