---
import type { SupportedLocale } from '@/i18n/config';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import Button from '@/components/ui/Button.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Section 6: marketing-section-light (#ffffff) with Inverted Featured Card per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-light" data-reveal>
  <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
    <!-- Inverted Featured Card: full-fill ink (#0b0b0b) on canvas-light (#ffffff) page -->
    <div class="max-w-4xl mx-auto rounded-marketing bg-ink text-on-primary p-6 sm:p-16 text-center">
      <div class="display-lg text-on-primary font-mono mb-2">$0</div>
      <h2 class="display-sm text-on-primary mb-4 break-words">
        {t('home.free.title')}
      </h2>
      <p class="body text-ash max-w-xl mx-auto mb-8 leading-relaxed">
        {t('home.free.description')}
      </p>
      <Button href={getLocalizedPath('/apps', lang)} variant="primary" class="px-8">
        {t('home.free.cta')}
      </Button>
    </div>
  </div>
</section>
