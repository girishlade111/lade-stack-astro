---
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { SupportedLocale } from '@/i18n/config';
import { getContent } from '@/i18n/content';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  lang: SupportedLocale;
  isPage?: boolean;
}

const { lang, isPage = false } = Astro.props;
const t = useTranslations(lang);
const products = getContent(lang).products;
---

<!-- Section 5: marketing-section-dark (#0b0b0b) per DESIGN.md Polarity-Flip Rhythm -->
<section id="products" class="marketing-section-dark" data-reveal>
  <div class="max-w-[1640px] mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <MonoEyebrow color="brand" class="mb-3">
        {t('home.products.eyebrow')}
      </MonoEyebrow>
      {isPage ? (
        <h1 class="display-md text-on-primary mb-4">
          {t('home.products.title')}
        </h1>
      ) : (
        <h2 class="display-md text-on-primary mb-4">
          {t('home.products.title')}
        </h2>
      )}
      <p class="subtitle text-ash">
        {t('home.products.subtitle')}
      </p>
    </div>

    <!-- Product Grid: 1 Brand-Card Anchor + Dark Cards (DESIGN.md Rule: at most 1 brand card per page) -->
    <div class="grid grid-cols-1 xs:grid-cols-2 gap-6 md:gap-8">
      {products.map((p, index) => {
        // First product anchors the eye as feature-card-brand (#f36458); others use feature-card-dark (#212121)
        const isBrandCard = index === 0;

        return isBrandCard ? (
          <FeatureCard variant="brand" class="flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="mono-micro px-2 py-1 rounded-full bg-ink text-on-primary">
                  {p.badge} • {t('common.featured')}
                </span>
                <Icon name={p.icon} class="w-6 h-6 text-ink" />
              </div>
              <h3 class="heading-md text-ink mb-2">
                {p.title}
              </h3>
              <p class="caption-tight text-ink/80 mb-3">{p.tagline}</p>
              <p class="body text-ink/90 leading-relaxed">{p.desc}</p>
            </div>
            <div class="mt-8 pt-6 border-t border-ink/20 flex items-center justify-between flex-wrap gap-2">
              <Button
                href={p.link.startsWith('http') ? p.link : getLocalizedPath(p.link, lang)}
                variant="primary-on-light"
                target={p.link.startsWith('http') ? '_blank' : '_self'}
                rel={p.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="!h-10 text-sm"
              >
                <span>{t('home.products.launch')}</span>
                <Icon name="lucide:arrow-up-right" class="w-4 h-4 ml-1.5" />
              </Button>
            </div>
          </FeatureCard>
        ) : (
          <FeatureCard variant="dark" class="flex flex-col justify-between hover:border-graphite transition-colors">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="mono-micro px-2 py-1 rounded-full bg-canvas-soft border border-hairline-soft text-ash">
                  {p.badge}
                </span>
                <Icon name={p.icon} class="w-6 h-6 text-brand" />
              </div>
              <h3 class="heading-md text-on-primary mb-2">
                {p.title}
              </h3>
              <p class="caption-tight text-ash mb-3">{p.tagline}</p>
              <p class="body text-ash leading-relaxed">{p.desc}</p>
            </div>
            <div class="mt-8 pt-6 border-t border-hairline-soft flex items-center justify-between flex-wrap gap-2">
              <Button
                href={p.link.startsWith('http') ? p.link : getLocalizedPath(p.link, lang)}
                variant="secondary-dark"
                target={p.link.startsWith('http') ? '_blank' : '_self'}
                rel={p.link.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span>{t('home.products.launch')}</span>
                <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 ml-1.5" />
              </Button>
            </div>
          </FeatureCard>
        );
      })}
    </div>
  </div>
</section>
