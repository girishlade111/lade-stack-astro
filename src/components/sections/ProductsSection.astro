---
import type { SupportedLocale } from '../../i18n/config';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import apps from '../../data/apps.json';

interface Props { lang: SupportedLocale; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const featured = apps.filter((a) => !a.comingSoon).slice(0, 5);

function hrefFor(app: (typeof apps)[number]): string {
  const url = app.landingUrl;
  if (url.startsWith('http')) return url;
  return getLocalizedPath(url, lang);
}
function external(url: string): boolean { return url.startsWith('http'); }
---
<section class="py-16 md:py-24 bg-card/40 border-y border-border" id="products">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-mono uppercase tracking-widest text-sage-500 text-center">{t('home.products.eyebrow')}</p>
    <h2 class="font-serif text-3xl md:text-5xl font-bold mt-3 text-center">{t('home.products.title')}</h2>
    <p class="mt-3 text-foreground/60 text-center">{t('home.products.subtitle')}</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map((app) => (
        <article class="rounded-2xl border border-border bg-background p-6 flex flex-col hover:border-sage-500/40 hover:shadow-lg transition-all">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sage-500/15 text-xl" aria-hidden="true">✦</span>
            <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">{t('apps.liveBadge')}</span>
          </div>
          <h3 class="mt-4 font-semibold text-lg">{app.title}</h3>
          <p class="text-sm text-sage-600 dark:text-sage-400">{app.tagline}</p>
          <p class="mt-2 text-sm text-foreground/65 flex-1">{app.description}</p>
          <a href={hrefFor(app)} target={external(app.landingUrl) ? '_blank' : undefined} rel={external(app.landingUrl) ? 'noopener noreferrer' : undefined} class="mt-4 inline-flex items-center justify-center h-10 px-4 rounded-full bg-sage-500 text-white text-sm font-semibold hover:bg-sage-600 transition-colors">
            {t('home.products.launch')} <span aria-hidden="true" class="ml-1">↗</span>
          </a>
        </article>
      ))}
      <a href={getLocalizedPath('/apps', lang)} class="rounded-2xl border border-dashed border-sage-500/40 p-6 flex flex-col items-center justify-center text-center hover:bg-sage-500/5 transition-colors min-h-[240px]">
        <span class="font-serif text-2xl">+4</span>
        <span class="mt-2 font-semibold text-sage-600 dark:text-sage-400">{t('home.products.viewGallery')}</span>
        <span aria-hidden="true" class="mt-1">→</span>
      </a>
    </div>
  </div>
</section>
