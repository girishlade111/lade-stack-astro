---
import type { SupportedLocale } from '../../i18n/config';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props { lang: SupportedLocale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-sage-500">{t('home.about.eyebrow')}</p>
      <h2 class="font-serif text-3xl md:text-5xl font-bold mt-3 leading-tight">{t('home.about.title')}</h2>
      <p class="mt-4 text-foreground/70 md:text-lg">{t('home.about.description')}</p>
      <a href={getLocalizedPath('/about', lang)} class="mt-6 inline-flex items-center gap-2 font-semibold text-sage-600 dark:text-sage-400 hover:gap-3 transition-all">
        {t('home.about.cta')} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="rounded-3xl border border-border bg-card/60 p-8 md:p-10">
      <p class="font-serif text-xl md:text-2xl leading-relaxed">“{t('home.about.description')}”</p>
      <p class="mt-4 text-sm text-foreground/60">— Girish Lade, Founder</p>
    </div>
  </div>
</section>
