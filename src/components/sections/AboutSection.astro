---
import type { SupportedLocale } from '@/i18n/config';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import Button from '@/components/ui/Button.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Section 2: marketing-section-light (#ffffff) per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-light" data-reveal>
  <div class="max-w-[1640px] mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <!-- Mono Eyebrow in IBM Plex Mono -->
      <MonoEyebrow color="mute" class="mb-3">
        {t('home.about.eyebrow')}
      </MonoEyebrow>

      <!-- Headline in display-md (48px / -1.68px tracking) -->
      <h2 class="display-md text-ink mb-6">
        {t('home.about.title')}
      </h2>

      <p class="body text-ink/80 mb-8 max-w-lg leading-relaxed">
        {t('home.about.description')}
      </p>

      <!-- button-primary-on-light (Black pill on light surface) -->
      <Button href={getLocalizedPath('/about', lang)} variant="primary-on-light">
        <span>{t('home.about.cta')}</span>
        <span class="ml-2" aria-hidden="true">→</span>
      </Button>
    </div>

    <!-- Quote in feature-card-light with 1px hairline border and soft-drop shadow -->
    <FeatureCard variant="light">
      <p class="subtitle text-ink font-serif italic mb-6 leading-relaxed">
        “{t('home.about.description')}”
      </p>
      <div class="pt-4 border-t border-hairline flex items-center justify-between">
        <span class="caption font-medium text-ink">— Girish Lade, Founder</span>
        <span class="mono-micro text-mute">Mumbai, India</span>
      </div>
    </FeatureCard>
  </div>
</section>
