---
import type { SupportedLocale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: t('home.impact.s1value'), label: t('home.impact.s1label') },
  { value: t('home.impact.s2value'), label: t('home.impact.s2label') },
  { value: t('home.impact.s3value'), label: t('home.impact.s3label') },
  { value: t('home.impact.s4value'), label: t('home.impact.s4label') },
];
---

<!-- Section 4: marketing-section-paper (#ededed) per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-paper" data-reveal>
  <div class="max-w-[1640px] mx-auto px-6 text-center">
    <MonoEyebrow color="mute" class="mb-3">
      {t('home.impact.eyebrow')}
    </MonoEyebrow>
    <h2 class="display-md text-ink mb-12">
      {t('home.impact.title')}
    </h2>

    <!-- Stat Tiles: feature-card-light on canvas-paper band -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
      {stats.map((s) => (
        <FeatureCard variant="light" class="text-center !p-8">
          <p class="display-md text-ink mb-2">{s.value}</p>
          <p class="caption text-ink/70">{s.label}</p>
        </FeatureCard>
      ))}
    </div>
  </div>
</section>
