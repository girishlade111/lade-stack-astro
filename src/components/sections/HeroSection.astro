---
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import type { SupportedLocale } from '@/i18n/config';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import Button from '@/components/ui/Button.astro';
import StudioWindow from '@/components/ui/StudioWindow.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Section 1: marketing-section-dark (#0b0b0b) per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-dark relative overflow-hidden">
  <div class="max-w-[1640px] mx-auto px-6">
    <!-- Centered Editorial Headline Lockup -->
    <div class="max-w-5xl mx-auto text-center mb-12">
      <!-- Mono Eyebrow in IBM Plex Mono (DESIGN.md signature lockup) -->
      <MonoEyebrow color="brand" class="mb-4">
        {t('hero.badge')}
      </MonoEyebrow>

      <!-- Editorial Display Mega (112px with -4.48px tracking) -->
      <h1 class="display-mega text-on-primary mb-8">
        {t('hero.title.part1')}
        <span class="block text-on-primary">{t('hero.title.part2')}</span>
      </h1>

      <!-- Subtitle (18px, -0.18px tracking) -->
      <p class="subtitle text-ash max-w-2xl mx-auto mb-10 leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Primary and Secondary Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <Button href={getLocalizedPath('/apps', lang)} variant="primary" class="w-full sm:w-auto px-8">
          <span>{t('hero.cta.primary')}</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4 ml-2" />
        </Button>
        <Button href={getLocalizedPath('/docs', lang)} variant="secondary-dark" class="w-full sm:w-auto px-6">
          <span>{t('hero.cta.secondary')}</span>
        </Button>
      </div>
    </div>

    <!-- Studio Window Mockup (DESIGN.md signature component) -->
    <div class="max-w-4xl mx-auto mb-16">
      <StudioWindow
        title="LadeStack Studio — terminal & code intelligence"
        tabs={['ai-code-viewer.ts', 'api-testing.json', 'preview.html']}
        activeTab="ai-code-viewer.ts"
      >
        <div class="p-4 space-y-1.5 font-mono text-xs text-ash">
          <p class="text-mute">// 100% Server-Rendered Developer Engine • Multi-Language SSG</p>
          <p><span class="text-brand">const</span> engine = <span class="text-link-blue-soft">initLadeStack</span>(&#123; locale: <span class="text-success">'{lang}'</span>, runtime: <span class="text-brand">0</span> &#125;);</p>
          <p class="text-on-primary">&#62; <span class="text-success">BUILD COMPLETE</span>: 27 blog posts, 10 developer tools, 0kb client js runtime</p>
          <p class="text-mute">&#62; Ready on <span class="text-link-blue-soft underline">https://ladestack.in</span></p>
        </div>
      </StudioWindow>
    </div>

    <!-- Key Metrics Grid: canvas-soft (#212121), hairline-soft (#353535) -->
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 pt-10 border-t border-hairline-soft">
      <div class="p-6 rounded-marketing bg-canvas-soft border border-hairline-soft text-center">
        <div class="display-md text-on-primary">8,000+</div>
        <div class="caption text-ash mt-1">{t('hero.stats.users')}</div>
      </div>
      <div class="p-6 rounded-marketing bg-canvas-soft border border-hairline-soft text-center">
        <div class="display-md text-brand">99.9%</div>
        <div class="caption text-ash mt-1">{t('hero.stats.uptime')}</div>
      </div>
      <div class="p-6 rounded-marketing bg-canvas-soft border border-hairline-soft text-center">
        <div class="display-md text-on-primary">$0</div>
        <div class="caption text-ash mt-1">{t('hero.stats.cost')}</div>
      </div>
    </div>
  </div>
</section>
