---
import type { SupportedLocale } from '@/i18n/config';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import MonoEyebrow from '@/components/ui/MonoEyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Section 7: marketing-section-dark (#0b0b0b) per DESIGN.md Polarity-Flip Rhythm -->
<section class="marketing-section-dark" data-reveal>
  <div class="max-w-[1640px] mx-auto px-4 sm:px-6 text-center">
    <MonoEyebrow color="brand" class="mb-3">
      {t('home.community.eyebrow')}
    </MonoEyebrow>
    <h2 class="display-md text-on-primary mb-4">
      {t('home.community.title')}
    </h2>
    <p class="body text-ash max-w-xl mx-auto mb-10 leading-relaxed">
      {t('home.community.description')}
    </p>

    <!-- CTAs: button-primary and button-secondary-dark -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        href="https://github.com/girishlade111"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        class="w-full sm:w-auto px-8"
      >
        <Icon name="lucide:github" class="w-4 h-4 mr-2" />
        <span>{t('home.community.ctaGithub')}</span>
      </Button>
      <Button
        href={getLocalizedPath('/contact', lang)}
        variant="secondary-dark"
        class="w-full sm:w-auto px-8"
      >
        <span>{t('home.community.ctaContact')}</span>
      </Button>
    </div>
  </div>
</section>
