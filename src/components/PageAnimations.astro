---
// PageAnimations: scroll-reveal + entrance choreography engine.
//
// Works hand-in-hand with <ClientRouter /> (astro:transitions):
// - Page-to-page motion is handled by the View Transition CSS in global.css.
// - This component handles everything else: elements tagged with `data-reveal`
//   fade/slide into view via IntersectionObserver, staggered via
//   `data-reveal-delay="120"` (ms). Re-initialised on every
//   `astro:page-load` so it survives View Transition swaps.
// - Respects prefers-reduced-motion: everything is shown instantly.
---

<script>
  const REVEAL_SELECTOR = '[data-reveal]:not([data-reveal-wired])';
  let observer: IntersectionObserver | null = null;

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function revealNow(el: Element): void {
    el.classList.add('is-visible');
  }

  function getObserver(): IntersectionObserver {
    if (observer) return observer;
    const current = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            revealNow(entry.target);
            current.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    observer = current;
    return current;
  }

  function setupReveals(): void {
    const els = document.querySelectorAll(REVEAL_SELECTOR);
    if (!els.length) return;

    // Reduced motion: show everything immediately, no observer needed.
    if (prefersReducedMotion()) {
      els.forEach((el) => {
        el.setAttribute('data-reveal-wired', 'true');
        revealNow(el);
      });
      return;
    }

    const io = getObserver();
    els.forEach((el) => {
      el.setAttribute('data-reveal-wired', 'true');
      const delay = el.getAttribute('data-reveal-delay');
      if (delay) {
        (el as HTMLElement).style.transitionDelay = `${delay}ms`;
      }
      io.observe(el);
    });
  }

  // Initial load + every View Transition navigation.
  setupReveals();
  document.addEventListener('astro:page-load', setupReveals);
  // After the new DOM is swapped in, re-scan (covers edge cases where
  // page-load ordering varies with persisted islands).
  document.addEventListener('astro:after-swap', setupReveals);
</script>
