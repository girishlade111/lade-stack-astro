---
import { Icon } from 'astro-icon/components';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class={`inline-flex items-center justify-center p-2 rounded-xl border border-border bg-card/60 hover:bg-muted text-foreground transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary ${className}`}
  aria-label="Toggle Dark Mode"
  aria-pressed="false"
>
  <!-- Sun Icon (shown in dark mode) -->
  <span class="hidden dark:block w-4 h-4" aria-hidden="true">
    <Icon name="lucide:sun" class="w-4 h-4 text-amber-400" />
  </span>
  <!-- Moon Icon (shown in light mode) -->
  <span class="block dark:hidden w-4 h-4" aria-hidden="true">
    <Icon name="lucide:moon" class="w-4 h-4 text-foreground/80" />
  </span>
</button>

<script>
  function setupThemeToggle(): void {
    // data-attribute (not id): Header renders one toggle for desktop + one for mobile
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
    const sync = (): void => {
      const isDark = document.documentElement.classList.contains('dark');
      buttons.forEach((btn) => btn.setAttribute('aria-pressed', isDark ? 'true' : 'false'));
    };
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('ladestack-theme', isDark ? 'dark' : 'light');
        } catch {
          /* private mode — theme simply won't persist */
        }
        sync();
      });
    });
    sync();
  }

  // Support initial load and view transitions
  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
